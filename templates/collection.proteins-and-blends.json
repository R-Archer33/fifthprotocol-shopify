{"sections":{"custom_liquid_MhQY7f":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n@import url('https:\/\/fonts.googleapis.com\/css2?family=Cinzel:wght@400;600;700&family=Raleway:wght@300;400;500;600&display=swap');\n\n.ca-wrap {\n  background: #080e14;\n  color: #d8e0e8;\n  font-family: 'Raleway', sans-serif;\n  font-weight: 300;\n  padding: 0;\n}\n\n.ca-wrap * { box-sizing: border-box; margin: 0; padding: 0; }\n\n\/* ── HERO ── *\/\n.ca-hero {\n  position: relative;\n  min-height: 420px;\n  display: flex;\n  align-items: flex-end;\n  border-radius: 8px;\n  overflow: hidden;\n  margin-bottom: 48px;\n}\n\n.ca-hero-bg {\n  position: absolute;\n  inset: 0;\n  background:\n    radial-gradient(ellipse at 20% 50%, rgba(74,143,212,0.14) 0%, transparent 60%),\n    radial-gradient(ellipse at 80% 20%, rgba(201,168,76,0.08) 0%, transparent 50%),\n    linear-gradient(135deg, #060d18 0%, #080f1a 50%, #060d18 100%);\n}\n\n.ca-hero-overlay {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(to top, rgba(8,14,20,0.95) 0%, rgba(8,14,20,0.4) 60%, transparent 100%);\n}\n\n.ca-hero-wave {\n  position: absolute;\n  top: 0; left: 0; right: 0;\n  height: 3px;\n  background: linear-gradient(90deg, transparent, #4a8fd4, #4caf78, #C9A84C, transparent);\n  opacity: 0.6;\n}\n\n.ca-hero-content {\n  position: relative;\n  z-index: 1;\n  padding: 48px 40px;\n  width: 100%;\n}\n\n.ca-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  background: rgba(74,143,212,0.12);\n  border: 1px solid rgba(74,143,212,0.25);\n  border-radius: 30px;\n  padding: 7px 20px;\n  font-family: 'Cinzel', serif;\n  font-size: 0.72rem;\n  letter-spacing: 0.25em;\n  color: #4a8fd4;\n  text-transform: uppercase;\n  margin-bottom: 20px;\n}\n\n.ca-hero h1 {\n  font-family: 'Cinzel', serif;\n  font-size: clamp(2.2rem, 6vw, 4rem);\n  font-weight: 700;\n  color: #fff;\n  line-height: 1.1;\n  margin-bottom: 8px;\n}\n\n.ca-hero h