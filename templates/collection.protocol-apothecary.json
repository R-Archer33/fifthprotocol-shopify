{"sections":{"custom_liquid_zk9WrF":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n@import url('https:\/\/fonts.googleapis.com\/css2?family=Cinzel:wght@400;600;700&family=Raleway:wght@300;400;500;600&display=swap');\n\n.ca-wrap {\n  background: #080e14;\n  color: #d8e0e8;\n  font-family: 'Raleway', sans-serif;\n  font-weight: 300;\n  padding: 0;\n}\n\n.ca-wrap * { box-sizing: border-box; margin: 0; padding: 0; }\n\n\/* ── HERO ── *\/\n.ca-hero {\n  position: relative;\n  min-height: 440px;\n  display: flex;\n  align-items: flex-end;\n  border-radius: 8px;\n  overflow: hidden;\n  margin-bottom: 48px;\n}\n\n.ca-hero-bg {\n  position: absolute;\n  inset: 0;\n  background:\n    radial-gradient(ellipse at 15% 50%, rgba(76,175,120,0.10) 0%, transparent 55%),\n    radial-gradient(ellipse at 50% 20%, rgba(123,111,224,0.07) 0%, transparent 50%),\n    radial-gradient(ellipse at 85% 60%, rgba(90,184,160,0.07) 0%, transparent 50%),\n    linear-gradient(135deg, #060d18 0%, #080f1a 50%, #060d18 100%);\n}\n\n.ca-hero-overlay {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(to top, rgba(8,14,20,0.96) 0%, rgba(8,14,20,0.35) 65%, transparent 100%);\n}\n\n.ca-hero-wave {\n  position: absolute;\n  top: 0; left: 0; right: 0;\n  height: 3px;\n  background: linear-gradient(90deg,\n    transparent,\n    #4caf78,\n    #7b6fe0,\n    #d4836a,\n    #5ab8a0,\n    #7eb8d4,\n    transparent\n  );\n  opacity: 0.65;\n}\n\n.ca-hero-stars {\n  position: absolute;\n  inset: 0;\n  background-image:\n    radial-gradient(1.5px 1.5px at 5%  8%,  rgba(255,255,255,0.65) 0%, transparent 100%),\n    radial-gradient(1px   1px   at 15% 25%,  rgba(255,255,255,0.40) 0%, transparent 100%),\n    radial-gradient(1px   1px   at 28% 55%,  rgba(255,255,255,0.35) 0%, transparent 100%),\n    radial-gradient(1.5px 1.5px at 42% 12%,  rgba(255,255,255,0.50) 0%, transparent 100%),\n    radial-gradient(1px   1px   at 58% 70%,  rgba(255,255,255,0.40) 0%, transparent 100%),\n    radial-gradient(1.5px 1.5px at 72% 38%,  rgba(255,255,255,0.55) 0%, transparent 100%),\n    radial-gradient(1px   1px   at 86% 82%,  rgba(255,255,255,0.35) 0%, transparent 100%),\n    radial-gradient(1px   1px   at 94% 22%,  rgba(255,255,255,0.45) 0%, transparent 100%);\n}\n\n.ca-hero-content {\n  position: relative;\n  z-index: 1;\n  padding: 52px 44px;\n  width: 100%;\n  display: flex;\n  align-items: flex-end;\n  gap: 40px;\n}\n\n.ca-hero-shield {\n  width: 160px;\n  height: 160px;\n  object-fit: contain;\n  flex-shrink: 0;\n  filter: drop-shadow(0 0 28px rgba(76,175,120,0.35));\n  animation: caFloat 5s ease-in-out infinite;\n}\n\n@keyframes caFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }\n\n.ca-hero-text { flex: 1; }\n\n.ca-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  background: rgba(76,175,120,0.10);\n  border: 1px solid rgba(76,175,120,0.25);\n  border-radius: 30px;\n  padding: 7px 20px;\n  font-family: 'Cinzel', serif;\n  font-size: 0.72rem;\n  letter-spacing: 0.25em;\n  color: #4caf78;\n  text-transform: uppercase;\n  margin-bottom: 18px;\n}\n\n.ca-hero h1 {\n  font-family: 'Cinzel', serif;\n  font-size: clamp(2.2rem, 6vw, 4rem);\n  font-weight: 700;\n  color: #fff;\n  line-height: 1.1;\n  margin-bottom: 8px;\n}\n\n.ca-hero h1 span { color: #C9A84C; text-shadow: 0 0 40px rgba(201,168,76,0.3); }\n\n.ca-hero-sub {\n  font-family: 'Cinzel', serif;\n  font-size: clamp(0.8rem, 1.5vw, 1rem);\n  letter-spacing: 0.25em;\n  color: #4caf78;\n  text-transform: uppercase;\n  margin-bottom: 18px;\n}\n\n.ca-hero p {\n  font-size: clamp(1rem, 1.8vw, 1.15rem);\n  line-height: 1.9;\n  color: #7a8fa6;\n  max-width: 580px;\n}\n\n\/* ── GOLD DIVIDER ── *\/\n.ca-divider {\n  width: 100%;\n  height: 1px;\n  background: linear-gradient(90deg, transparent, #C9A84C, transparent);\n  opacity: 0.3;\n  margin: 40px 0;\n}\n\n\/* ── FIVE PROTOCOL STRIP ── *\/\n.ca-protocol-strip {\n  display: grid;\n  grid-template-columns: repeat(5, 1fr);\n  gap: 12px;\n  margin-bottom: 48px;\n}\n\n.ca-proto-card {\n  background: rgba(10,25,42,0.85);\n  border-radius: 6px;\n  padding: 22px 16px;\n  text-align: center;\n  border: 1px solid rgba(255,255,255,0.06);\n  transition: transform 0.28s ease, border-color 0.28s ease, box-shadow 0.28s ease;\n  text-decoration: none;\n  display: block;\n  position: relative;\n  overflow: hidden;\n}\n\n.ca-proto-card::before {\n  content: '';\n  position: absolute;\n  bottom: 0; left: 0; right: 0;\n  height: 2px;\n  opacity: 0;\n  transition: opacity 0.28s ease;\n}\n\n.ca-proto-card:hover { transform: translateY(-3px); }\n.ca-proto-card:hover::before { opacity: 1; }\n\n.ca-proto-card.body    { --pc: #4caf78; }\n.ca-proto-card.mind    { --pc: #7b6fe0; }\n.ca-proto-card.soul    { --pc: #d4836a; }\n.ca-proto-card.earth   { --pc: #5ab8a0; }\n.ca-proto-card.universe { --pc: #7eb8d4; }\n\n.ca-proto-card:hover { border-color: var(--pc); box-shadow: 0 8px 28px rgba(0,0,0,0.2); }\n.ca-proto-card::before { background: linear-gradient(90deg, transparent, var(--pc), transparent); }\n\n.ca-proto-icon  { font-size: 1.6rem; margin-bottom: 8px; display: block; }\n\n.ca-proto-num {\n  font-family: 'Cinzel', serif;\n  font-size: 0.62rem;\n  letter-spacing: 0.2em;\n  color: var(--pc);\n  text-transform: uppercase;\n  margin-bottom: 4px;\n  display: block;\n}\n\n.ca-proto-name {\n  font-family: 'Cinzel', serif;\n  font-size: 0.82rem;\n  font-weight: 600;\n  color: #fff;\n  display: block;\n}\n\n\/* ── WHAT IS IT ── *\/\n.ca-source {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 48px;\n  align-items: center;\n  margin-bottom: 48px;\n}\n\n.ca-source-text .ca-label {\n  font-family: 'Cinzel', serif;\n  font-size: 0.72rem;\n  letter-spacing: 0.3em;\n  color: #C9A84C;\n  text-transform: uppercase;\n  margin-bottom: 12px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n.ca-source-text .ca-label::before { content: ''; width: 24px; height: 1px; background: #C9A84C; }\n\n.ca-source-text h2 {\n  font-family: 'Cinzel', serif;\n  font-size: clamp(1.4rem, 3vw, 2.2rem);\n  font-weight: 600;\n  color: #fff;\n  margin-bottom: 20px;\n  line-height: 1.2;\n}\n.ca-source-text h2 span { color: #4caf78; }\n\n.ca-source-text p {\n  font-size: 1rem;\n  line-height: 1.9;\n  color: #7a8fa6;\n  margin-bottom: 16px;\n}\n.ca-source-text p:last-child { margin-bottom: 0; }\n.ca-source-text p strong { color: #d8e0e8; font-weight: 500; }\n\n.ca-source-stats {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 16px;\n}\n\n.ca-stat {\n  background: rgba(10,25,42,0.85);\n  border: 1px solid rgba(201,168,76,0.15);\n  border-radius: 6px;\n  padding: 24px 20px;\n  text-align: center;\n}\n\n.ca-stat-icon { font-size: 1.8rem; margin-bottom: 8px; display: block; }\n\n.ca-stat h4 {\n  font-family: 'Cinzel', serif;\n  font-size: 0.85rem;\n  font-weight: 600;\n  color: #fff;\n  margin-bottom: 4px;\n}\n\n.ca-stat p { font-size: 0.8rem; color: #7a8fa6; line-height: 1.5; }\n\n\/* ── PHILOSOPHY ── *\/\n.ca-philosophy {\n  background: linear-gradient(135deg, rgba(76,175,120,0.05), rgba(10,25,42,0.85));\n  border: 1px solid rgba(76,175,120,0.15);\n  border-radius: 8px;\n  padding: 48px 40px;\n  margin-bottom: 48px;\n  text-align: center;\n}\n\n.ca-philosophy blockquote {\n  font-family: 'Cinzel', serif;\n  font-size: clamp(1.2rem, 3vw, 1.8rem);\n  font-weight: 400;\n  color: #fff;\n  line-height: 1.6;\n  margin-bottom: 16px;\n  font-style: italic;\n}\n\n.ca-philosophy blockquote span { color: #C9A84C; }\n\n.ca-philosophy cite {\n  font-family: 'Cinzel', serif;\n  font-size: 0.75rem;\n  letter-spacing: 0.25em;\n  color: #4caf78;\n  text-transform: uppercase;\n  font-style: normal;\n}\n\n\/* ── CATEGORIES ── *\/\n.ca-categories { margin-bottom: 48px; }\n\n.ca-categories .ca-label {\n  font-family: 'Cinzel', serif;\n  font-size: 0.72rem;\n  letter-spacing: 0.3em;\n  color: #C9A84C;\n  text-transform: uppercase;\n  margin-bot