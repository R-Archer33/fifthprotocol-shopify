, 1fr));\n  gap: 16px;\n  margin-bottom: 48px;\n}\n\n.ca-standard {\n  text-align: center;\n  padding: 28px 20px;\n  background: rgba(10,25,42,0.6);\n  border: 1px solid rgba(201,168,76,0.12);\n  border-radius: 6px;\n}\n\n.ca-standard-icon { font-size: 1.8rem; margin-bottom: 10px; display: block; }\n\n.ca-standard h4 {\n  font-family: 'Cinzel', serif;\n  font-size: 0.82rem;\n  font-weight: 600;\n  color: #fff;\n  margin-bottom: 6px;\n  letter-spacing: 0.05em;\n}\n\n.ca-standard p {\n  font-size: 0.78rem;\n  line-height: 1.6;\n  color: #7a8fa6;\n}\n\n\/* ── MISSION STRIP ── *\/\n.ca-mission {\n  background: linear-gradient(135deg, rgba(46,125,79,0.08), rgba(10,25,42,0.7));\n  border: 1px solid rgba(76,175,120,0.2);\n  border-radius: 8px;\n  padding: 40px;\n  display: flex;\n  align-items: center;\n  gap: 32px;\n  margin-bottom: 32px;\n}\n\n.ca-mission-icon { font-size: 2.8rem; flex-shrink: 0; }\n\n.ca-mission h3 {\n  font-family: 'Cinzel', serif;\n  font-size: 1.2rem;\n  font-weight: 600;\n  color: #fff;\n  margin-bottom: 10px;\n}\n\n.ca-mission h3 span { color: #4caf78; }\n\n.ca-mission p {\n  font-size: 0.95rem;\n  line-height: 1.8;\n  color: #7a8fa6;\n}\n\n.ca-mission p strong { color: #4caf78; font-weight: 500; }\n\n\/* ── TAGLINE ── *\/\n.ca-tagline {\n  text-align: center;\n  padding: 32px 24px;\n  font-family: 'Cinzel', serif;\n  font-size: clamp(1rem, 2vw, 1.3rem);\n  font-weight: 600;\n  color: #fff;\n  letter-spacing: 0.1em;\n  border-top: 1px solid rgba(255,255,255,0.06);\n}\n\n.ca-tagline span { color: #C9A84C; }\n\n@media (max-width: 700px) {\n  .ca-source { grid-template-columns: 1fr; gap: 32px; }\n  .ca-hero-content { padding: 32px 24px; }\n  .ca-mission { flex-direction: column; text-align: center; }\n  .ca-philosophy { padding: 32px 24px; }\n}\n<\/style>\n\n<div class=\"ca-wrap\">\n\n  <!-- HERO -->\n  <div class=\"ca-hero\">\n    <div class=\"ca-hero-bg\"><\/div>\n    <div class=\"ca-hero-overlay\"><\/div>\n    <div class=\"ca-hero-wave\"><\/div>\n    <div class=\"ca-hero-content\">\n      <div class=\"ca-badge\">✦ Healthy Kindness · Earth &amp; Body<\/div>\n      <h1>Natural <span>Extracts<\/span><\/h1>\n      <p class=\"ca-hero-sub\">Mushroom Extracts · Botanicals · Adaptogens<\/p>\n      <p>Nature has been refining its chemistry for millions of years. This collection brings together concentrated plant and fungal extracts — mushrooms, adaptogens, and botanicals with deep roots in traditional medicine and growing support in modern research — formulated to support immunity, resilience, cognition, and long-term wellness.<\/p>\n    <\/div>\n  <\/div>\n\n  <!-- SOURCE STORY -->\n  <div class=\"ca-source\">\n    <div class=\"ca-source-text\">\n      <div class=\"ca-label\">The Source<\/div>\n      <h2>Drawn from <span>Living Systems<\/span><\/h2>\n      <p>Extracts are concentrated — meaning the active compounds found in roots, barks, fungi, and plants are isolated and preserved so your body receives more of what matters in every dose. The difference between a raw herb and a quality extract is the difference between eating a handful of blueberries and taking a concentrated anthocyanin formula.<\/p>\n      <p>Every extract in this collection is selected based on <strong>documented traditional use<\/strong>, the strength of available research, and the quality of the sourcing and extraction process. We do not carry anything simply because it is trending.<\/p>\n      <p>This collection is built in direct connection with the <strong>Fifth Protocol Earth and Body curricula<\/strong> — bridging ancient botanical wisdom with the nutritional science your body actually needs.<\/p>\n    <\/div>\n    <div class=\"ca-source-stats\">\n      <div class=\"ca-stat\">\n        <span class=\"ca-stat-icon\">🍄<\/span>\n        <h4>Fruiting Body<\/h4>\n        <p>Mushroom extracts sourced from the fruiting body — not mycelium on grain<\/p>\n      <\/div>\n      <div class=\"ca-stat\">\n        <span class=\"ca-stat-icon\">🌿<\/span>\n        <h4>Concentrated<\/h4>\n        <p>Standardized extracts deliver consistent levels of active compounds per dose<\/p>\n      <\/div>\n      <div class=\"ca-stat\">\n        <span class=\"ca-stat-icon\">📜<\/span>\n        <h4>Traditional Roots<\/h4>\n        <p>Centuries of documented use across Ayurvedic, Chinese, and herbal medicine traditions<\/p>\n      <\/div>\n      <div class=\"ca-stat\">\n        <span class=\"ca-stat-icon\">🔬<\/span>\n        <h4>Research-Supported<\/h4>\n        <p>Selected based on the quality and consistency of available scientific literature<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <div class=\"ca-divider\"><\/div>\n\n  <!-- PHILOSOPHY -->\n  <div class=\"ca-philosophy\">\n    <blockquote>\n      \"The earth has been producing medicine<br>\n      far longer than we have been <span>looking for it.<\/span>\"\n    <\/blockquote>\n    <cite>Natural Extracts · Healthy Kindness · Fifth Protocol<\/cite>\n  <\/div>\n\n  <div class=\"ca-divider\"><\/div>\n\n  <!-- CATEGORIES -->\n  <div class=\"ca-categories\">\n    <div class=\"ca-label\">What's Inside<\/div>\n    <h2>The <span>Collection<\/span><\/h2>\n    <div class=\"ca-cat-grid\">\n\n      <div class=\"ca-cat-card mushroom\">\n        <span class=\"ca-cat-icon\">🍄<\/span>\n        <h3>Mushroom Extracts<\/h3>\n        <p>Functional fungi with some of the most compelling research in natural wellness. Each extract is sourced from the fruiting body — where the active beta-glucans, triterpenes, and polysaccharides are concentrated.<\/p>\n        <ul class=\"ca-cat-items\">\n          <li>Lion's Mane — cognitive support &amp; nerve health<\/li>\n          <li>Reishi — immune modulation &amp; stress response<\/li>\n          <li>Chaga — antioxidant &amp; immune support<\/li>\n          <li>Cordyceps — energy &amp; endurance<\/li>\n          <li>Turkey Tail — gut &amp; immune health<\/li>\n        <\/ul>\n      <\/div>\n\n      <div class=\"ca-cat-card botanical\">\n        <span class=\"ca-cat-icon\">🌿<\/span>\n        <h3>Botanical Extracts<\/h3>\n        <p>Concentrated plant extracts drawn from roots, barks, seeds, and leaves with well-documented histories in traditional medicine and meaningful support in modern nutritional science.<\/p>\n        <ul class=\"ca-cat-items\">\n          <li>Turmeric &amp; Curcumin — inflammation support<\/li>\n          <li>Elderberry — immune &amp; antioxidant support<\/li>\n          <li>Milk Thistle — liver &amp; detox support<\/li>\n          <li>Echinacea — immune activation<\/li>\n          <li>Expanding regularly<\/li>\n        <\/ul>\n      <\/div>\n\n      <div class=\"ca-cat-card adaptogen\">\n        <span class=\"ca-cat-icon\">⚖️<\/span>\n        <h3>Adaptogens<\/h3>\n        <p>A specific class of botanical extracts that help the body adapt to physical and mental stress — supporting hormonal balance, adrenal health, resilience, and sustained energy without overstimulation.<\/p>\n        <ul class=\"ca-cat-items\">\n          <li>Ashwagandha — stress, cortisol &amp; recovery<\/li>\n          <li>Rhodiola Rosea — fatigue &amp; mental clarity<\/li>\n          <li>Holy Basil (Tulsi) — stress &amp; inflammation<\/li>\n          <li>Maca Root — energy &amp; hormonal support<\/li>\n          <li>New additions coming regularly<\/li>\n        <\/ul>\n      <\/div>\n\n    <\/div>\n  <\/div>\n\n  <div class=\"ca-divider\"><\/div>\n\n  <!-- STANDARDS -->\n  <div class=\"ca-label\" style=\"font-family:'Cinzel',serif;font-size:0.72rem;letter-spacing:0.3em;color:#C9A84C;text-transform:uppercase;margin-bottom:12px;display:flex;align-items:center;gap:10px;\">\n    <span style=\"width:24px;height:1px;background:#C9A84C;display:inline-block;\"><\/span>\n    Our Standards\n  <\/div>\n  <h2 style=\"font-family:'Cinzel',serif;font-size:clamp(1.4rem,3vw,2.2rem);font-weight:600;color:#fff;margin-bottom:28px;\">\n    What We Will <span style=\"color:#C9A84C;\">Never Compromise<\/span>\n  <\/h2>\n\n  <div class=\"ca-standards\">\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">🍄<\/span>\n      <h4>Fruiting Body Only<\/h4>\n      <p>Mushroom products use fruiting body extracts — not mycelium grown on grain, which dilutes potency with starch content.<\/p>\n    <\/div>\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">📊<\/span>\n      <h4>Standardized Extracts<\/h4>\n      <p>Where applicable, we use standardized extracts so active compound levels are consistent and measurable across every batch.<\/p>\n    <\/div>\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">🌍<\/span>\n      <h4>Responsible Sourcing<\/h4>\n      <p>We work with suppliers who respect the ecosystems and traditions these plants and fungi come from.<\/p>\n    <\/div>\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">🚫<\/span>\n      <h4>No Unnecessary Additives<\/h4>\n      <p>No artificial colors, flavors, or fillers. What's on the label is what's in the product.<\/p>\n    <\/div>\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">📖<\/span>\n      <h4>Education First<\/h4>\n      <p>Every product connects to the Fifth Protocol Earth and Body curricula — so you understand what you're taking and why.<\/p>\n    <\/div>\n  <\/div>\n\n  <div class=\"ca-divider\"><\/div>\n\n  <!-- MISSION -->\n  <div class=\"ca-mission\">\n    <div class=\"ca-mission-icon\">🤝<\/div>\n    <div>\n      <h3>Every Purchase <span>Funds the Mission<\/span><\/h3>\n      <p>The Natural Extracts collection is powered by <strong>Healthy Kindness<\/strong> — and every product you buy supports the <strong>Fifth Protocol mission<\/strong> of educating communities with truth, empowering individuals with real tools for their health, and giving nonprofits a better way to fundraise than selling junk food.<\/p>\n    <\/div>\n  <\/div>\n\n  <!-- TAGLINE -->\n  <div class=\"ca-tagline\">\n    <span>Be True.<\/span> Live Well.\n  <\/div>\n\n<\/div>",