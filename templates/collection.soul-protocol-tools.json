{"sections":{"banner":{"type":"main-collection-banner","settings":{"show_collection_description":true,"show_collection_image":false,"color_scheme":"scheme-1"}},"product-grid":{"type":"main-collection-product-grid","settings":{"products_per_page":24,"columns_desktop":4,"columns_mobile":"2","color_scheme":"scheme-1","image_ratio":"portrait","image_shape":"default","show_secondary_image":true,"show_vendor":false,"show_rating":false,"quick_add":"standard","enable_filtering":true,"filter_type":"horizontal","enable_sorting":true,"padding_top":0,"padding_bottom":60}},"custom_liquid_EEy7CU":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n@import url('https:\/\/fonts.googleapis.com\/css2?family=Cinzel:wght@400;600;700&family=Raleway:wght@300;400;500;600;700&display=swap');\n\n\/* ════════════════════════════════════════\n   SOUL PROTOCOL TOOLS — Collection Page\n   Visual system: Soul Protocol (amber-rose accent)\n   Purpose: Protocol-aligned tools for learning application\n════════════════════════════════════════ *\/\n:root {\n  --black:           #080e14;\n  --navy:            #0B1F3A;\n  --gold:            #C9A84C;\n  --gold-light:      #f0d080;\n  --gold-glow:       rgba(201,168,76,0.15);\n  --gold-border:     rgba(201,168,76,0.3);\n  --text:            #e8edf2;\n  --text-muted:      #9aacbe;\n  --card-bg:         rgba(10,25,42,0.88);\n  --protocol-color:  #d4836a;\n  --protocol-dark:   #a0513c;\n  --protocol-darker: #733324;\n  --protocol-glow:   rgba(212,131,106,0.35);\n  --protocol-border: rgba(212,131,106,0.3);\n  --protocol-bg:     rgba(212,131,106,0.12);\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\n\n\/* SHOPIFY SAFE OVERRIDES *\/\nbody,\n.shopify-section,\n.main-content,\n#MainContent,\n.page-width,\n.container,\n[class*=\"section\"],\n[class*=\"page\"] {\n  background: var(--black) !important;\n  color: var(--text) !important;\n}\n\n.bpt-wrap {\n  background: var(--black);\n  color: var(--text);\n  font-family: 'Raleway', sans-serif;\n  font-weight: 400;\n  font-size: 1.05rem;\n  line-height: 1.8;\n  overflow-x: hidden;\n  width: 100%;\n}\n\n.bpt-wrap a { text-decoration: none; color: inherit; }\n.bpt-wrap img { display: block; }\n\n\/* ── STARFIELD ── *\/\n.bpt-starfield {\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  pointer-events: none;\n  overflow: hidden;\n  background:\n    radial-gradient(ellipse at 18% 22%, rgba(160,81,60,0.10) 0%, transparent 58%),\n    radial-gradient(ellipse at 78% 78%, rgba(11,31,58,0.55) 0%, transparent 68%);\n}\n\n.bpt-starfield::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background-image:\n    radial-gradient(1.5px 1.5px at 6%  9%,  rgba(255,255,255,0.70) 0%, transparent 100%),\n    radial-gradient(1px   1px   at 16% 28%,  rgba(255,255,255,0.40) 0%, transparent 100%),\n    radial-gradient(1px   1px   at 24% 58%,  rgba(255,255,255,0.35) 0%, transparent 100%),\n    radial-gradient(1.5px 1.5px at 34% 14%,  rgba(255,255,255,0.55) 0%, transparent 100%),\n    radial-gradient(1px   1px   at 44% 72%,  rgba(255,255,255,0.40) 0%, transparent 100%),\n    radial-gradient(1.5px 1.5px at 60% 88%,  rgba(255,255,255,0.50) 0%, transparent 100%),\n    radial-gradient(1.5px 1.5px at 74% 46%,  rgba(255,255,255,0.60) 0%, transparent 100%),\n    radial-gradient(1px   1px   at 88% 32%,  rgba(255,255,255,0.40) 0%, transparent 100%),\n    radial-gradient(1.5px 1.5px at 94% 74%,  rgba(255,255,255,0.50) 0%, transparent 100%);\n  animation: bptTwinkle 9s ease infinite alternate;\n}\n\n@keyframes bptTwinkle { 0% { opacity: 0.45; } 100% { opacity: 1; } }\n\n\/* ── DIVIDER ── *\/\n.bpt-divider {\n  width: 100%;\n  height: 1px;\n  background: linear-gradient(90deg, transparent, var(--gold), transparent);\n  opacity: 0.3;\n}\n\n\/* ════════════════════════════════════════\n   HERO\n════════════════════════════════════════ *\/\n.bpt-hero {\n  position: relative;\n  min-height: 78vh;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n  padding: 90px 24px 80px;\n  overflow: hidden;\n}\n\n.bpt-hero-content {\n  position: relative;\n  z-index: 2;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n}\n\n.bpt-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  border: 1px solid var(--protocol-border);\n  background: var(--protocol-bg);\n  border-radius: 40px;\n  padding: 9px 24px;\n  font-family: 'Cinzel', serif;\n  font-size: 0.76rem;\n  letter-spacing: 0.22em;\n  color: var(--protocol-color);\n  text-transform: uppercase;\n  margin-bottom: 26px;\n  animation: bptFadeUp 0.8s ease both;\n}\n\n.bpt-badge .dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--protocol-color);\n  box-shadow: 0 0 8px var(--protocol-color);\n  animation: bptPulse 2s ease infinite;\n}\n\n@keyframes bptPulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.75); } }\n\n.bpt-hero-eyebrow {\n  font-family: 'Cinzel', serif;\n  font-size: clamp(0.68rem, 1.4vw, 0.82rem);\n  letter-spacing: 0.38em;\n  color: var(--gold);\n  text-transform: uppercase;\n  margin-bottom: 20px;\n  animation: bptFadeUp 0.9s ease both 0.1s;\n}\n\n.bpt-hero-shield {\n  width: 220px;\n  height: 220px;\n  object-fit: contain;\n  margin-bottom: 26px;\n  filter: drop-shadow(0 0 36px var(--protocol-glow));\n  animation: bptFloat 5s ease-in-out infinite, bptFadeUp 1s ease both 0.15s;\n}\n\n@keyframes bptFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-9px); } }\n\n.bpt-hero h1 {\n  font-family: 'Cinzel', serif;\n  font-size: clamp(2.4rem, 6vw, 5rem);\n  font-weight: 700;\n  color: #fff;\n  line-height: 1.05;\n  margin-bottom: 12px;\n  letter-spacing: 0.04em;\n  animation: bptFadeUp 1s ease both 0.2s;\n}\n\n.bpt-hero h1 span { color: var(--protocol-color); text-shadow: 0 0 48px var(--protocol-glow); }\n\n.bpt-hero-sub {\n  font-family: 'Cinzel', serif;\n  font-size: clamp(0.85rem, 1.8vw, 1.1rem);\n  letter-spacing: 0.24em;\n  color: var(--gold);\n  text-transform: uppercase;\n  margin-bottom: 20px;\n  animation: bptFadeUp 1s ease both 0.3s;\n}\n\n.bpt-hero-desc {\n  max-width: 620px;\n  font-size: clamp(1rem, 2vw, 1.15rem);\n  line-height: 1.9;\n  color: var(--text-muted);\n  animation: bptFadeUp 1s ease both 0.4s;\n}\n\n\/* ════════════════════════════════════════\n   INNER CONTENT CONTAINER\n════════════════════════════════════════ *\/\n.bpt-inner {\n  max-width: 1100px;\n  margin: 0 auto;\n  padding: 72px 24px;\n}\n\n.bpt-section-label {\n  font-family: 'Cinzel', serif;\n  font-size: 0.76rem;\n  letter-spacing: 0.32em;\n  color: var(--protocol-color);\n  text-transform: uppercase;\n  margin-bottom: 14px;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.bpt-section-label::before {\n  content: '';\n  width: 26px;\n  height: 1px;\n  background: var(--protocol-color);\n  flex-shrink: 0;\n}\n\n.bpt-section-label.gold { color: var(--gold); }\n.bpt-section-label.gold::before { background: var(--gold); }\n.bpt-section-label.centered { justify-content: center; }\n.bpt-section-label.centered::before { display: none; }\n\n.bpt-section-title {\n  font-family: 'Cinzel', serif;\n  font-size: clamp(1.5rem, 3.5vw, 2.2rem);\n  font-weight: 600;\n  color: #fff;\n  line-height: 1.2;\n  margin-bottom: 14px;\n}\n\n.bpt-section-title span { color: var(--protocol-color); }\n.bpt-section-title span.gold { color: var(--gold); }\n\n.bpt-section-desc {\n  font-size: 1.05rem;\n  line-height: 1.9;\n  color: var(--text-muted);\n  max-width: 680px;\n  margin-bottom: 40px;\n}\n\n\/* ════════════════════════════════════════\n   CATEGORY CARDS\n════════════════════════════════════════ *\/\n.bpt-cat-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n  gap: 20px;\n}\n\n.bpt-cat-card {\n  background: var(--card-bg);\n  border: 1px solid var(--protocol-border);\n  border-radius: 6px;\n  padding: 34px 28px;\n  position: relative;\n  overflow: hidden;\n  transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;\n}\n\n.bpt-cat-card::before {\n  content: '';\n  position: absolute;\n  top: 0; left: 0; right: 0;\n  height: 2px;\n  background: linear-gradient(90deg, transparent, var(--protocol-color), transparent);\n  opacity: 0;\n  transition: opacity 0.28s ease;\n}\n\n.bpt-cat-card:hover { transform: translateY(-4px); box-shadow: 0 12px 36px rgba(160,81,60,0.14); border-color: var(--protocol-color); }\n.bpt-cat-card:hover::before { opacity: 1; }\n\n.bpt-cat-icon {\n  width: 52px;\n  height: 52px;\n  background: var(--protocol-bg);\n  border: 1px solid var(--protocol-border);\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 1.4rem;\n  margin-bottom: 16px;\n}\n\n.bpt-cat-card h3 {\n  font-family: 'Cinzel', serif;\n  font-size: 1.05rem;\n  font-weight: 600;\n  color: var(--protocol-color);\n  margin-bottom: 10px;\n  letter-spacing: 0.04em;\n}\n\n.bpt-cat-card p {\n  font-size: 0.92rem;\n  line-height: 1.78;\n  color: var(--text-muted);\n  margin-bottom: 18px;\n}\n\n.bpt-cat-examples { list-style: none; }\n\n.bpt-cat-examples li {\n  font-size: 0.82rem;\n  color: var(--text-muted);\n  padding: 5px 0;\n  border-bottom: 1px solid rgba(255,255,255,0.04);\n  display: flex;\n  align-items: center;\n  gap: 9px;\n}\n\n.bpt-cat-examples li:last-child { border-bottom: none; }\n\n.bpt-cat-examples li::before {\n  content: '◆';\n  font-size: 0.38rem;\n  color: var(--protocol-color);\n  flex-shrink: 0;\n}\n\n\/* ════════════════════════════════════════\n   PRODUCT GRID\n════════════════════════════════════════ *\/\n.bpt-products-header { text-align: center; margin-bottom: 36px; }\n\n.bpt-product-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));\n  gap: 22px;\n}\n\n.bpt-product-grid .card-wrapper,\n.bpt-product-grid .product-card-wrapper {\n  background: var(--card-bg) !important;\n  border: 1px solid var(--protocol-border) !important;\n  border-radius: 6px !important;\n  overflow: hidden;\n  transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease !important;\n}\n\n.bpt-product-grid .card-wrapper:hover,\n.bpt-product-grid .product-card-wrapper:hover {\n  transform: translateY(-4px) !important;\n  box-shadow: 0 12px 36px rgba(160,81,60,0.12) !important;\n  border-color: var(--protocol-color) !important;\n}\n\n.bpt-product-grid .card__heading a,\n.bpt-product-grid .card__heading,\n.bpt-product-grid h3 a {\n  font-family: 'Cinzel', serif !important;\n  font-size: 0.92rem !important;\n  color: #fff !important;\n  letter-spacing: 0.04em !important;\n}\n\n.bpt-product-grid .price,\n.bpt-product-grid .price__regular,\n.bpt-product-grid .price-item {\n  color: var(--gold) !important;\n  font-family: 'Cinzel', serif !important;\n  font-size: 0.88rem !important;\n}\n\n.bpt-product-grid .card__information {\n  background: var(--card-bg) !important;\n  padding: 16px !important;\n}\n\n.bpt-product-item {\n  background: var(--card-bg);\n  border: 1px solid var(--protocol-border);\n  border-radius: 6px;\n  overflow: hidden;\n  transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;\n  display: flex;\n  flex-direction: column;\n}\n\n.bpt-product-item:hover {\n  transform: translateY(-4px);\n  box-shadow: 0 12px 36px rgba(160,81,60,0.12);\n  border-color: var(--protocol-color);\n}\n\n.bpt-product-img {\n  width: 100%;\n  aspect-ratio: 1 \/ 1;\n  object-fit: cover;\n  display: block;\n  background: rgba(10,25,42,0.6);\n}\n\n.bpt-product-img-placeholder {\n  width: 100%;\n  aspect-ratio: 1 \/ 1;\n  background: linear-gradient(135deg, rgba(160,81,60,0.12), rgba(10,25,42,0.8));\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 3rem;\n}\n\n.bpt-product-info {\n  padding: 18px 20px;\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.bpt-product-title {\n  font-family: 'Cinzel', serif;\n  font-size: 0.9rem;\n  font-weight: 600;\n  color: #fff;\n  letter-spacing: 0.04em;\n  line-height: 1.35;\n}\n\n.bpt-product-vendor {\n  font-size: 0.72rem;\n  letter-spacing: 0.18em;\n  color: var(--protocol-color);\n  text-transform: uppercase;\n  font-family: 'Cinzel', serif;\n}\n\n.bpt-product-price {\n  font-family: 'Cinzel', serif;\n  font-size: 0.88rem;\n  color: var(--gold);\n  margin-top: auto;\n  padding-top: 6px;\n}\n\n.bpt-product-link {\n  display: block;\n  margin-top: 12px;\n  text-align: center;\n  padding: 10px 16px;\n  background: linear-gradient(135deg, var(--protocol-dark), var(--protocol-darker));\n  color: #fff !important;\n  font-family: 'Cinzel', serif;\n  font-size: 0.68rem;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  border-radius: 3px;\n  border: 1px solid var(--protocol-border);\n  transition: box-shadow 0.28s ease, transform 0.28s ease;\n}\n\n.bpt-product-link:hover {\n  transform: translateY(-1px);\n  box-shadow: 0 6px 20px rgba(160,81,60,0.32);\n}\n\n.bpt-empty {\n  text-align: center;\n  padding: 60px 24px;\n  color: var(--text-muted);\n  font-family: 'Cinzel', serif;\n  font-size: 0.9rem;\n  letter-spacing: 0.12em;\n  border: 1px dashed rgba(255,255,255,0.1);\n  border-radius: 6px;\n}\n\n\/* ════════════════════════════════════════\n   EDUCATIONAL NOTE\n════════════════════════════════════════ *\/\n.bpt-edu-note {\n  background: linear-gradient(135deg, rgba(160,81,60,0.07), rgba(10,25,42,0.75));\n  border: 1px solid var(--protocol-border);\n  border-radius: 6px;\n  padding: 44px 40px;\n  display: grid;\n  grid-template-columns: auto 1fr;\n  gap: 28px;\n  align-items: start;\n}\n\n.bpt-edu-icon {\n  width: 56px;\n  height: 56px;\n  background: var(--protocol-bg);\n  border: 1px solid var(--protocol-border);\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 1.5rem;\n  flex-shrink: 0;\n  margin-top: 2px;\n}\n\n.bpt-edu-note h3 {\n  font-family: 'Cinzel', serif;\n  font-size: clamp(1rem, 2.5vw, 1.3rem);\n  font-weight: 600;\n  color: #fff;\n  margin-bottom: 12px;\n  line-height: 1.3;\n}\n\n.bpt-edu-note h3 span { color: var(--protocol-color); }\n\n.bpt-edu-note p {\n  font-size: 0.98rem;\n  line-height: 1.88;\n  color: var(--text-muted);\n  margin-bottom: 14px;\n}\n\n.bpt-edu-note p:last-child { margin-bottom: 0; }\n.bpt-edu-note p strong { color: var(--text); font-weight: 500; }\n\n.bpt-edu-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  font-family: 'Cinzel', serif;\n  font-size: 0.72rem;\n  letter-spacing: 0.2em;\n  color: var(--protocol-color);\n  text-transform: uppercase;\n  text-decoration: none;\n  margin-top: 6px;\n  transition: opacity 0.2s ease;\n}\n\n.bpt-edu-link:hover { opacity: 0.75; }\n\n\/* ════════════════════════════════════════\n   FOOTER STRIP\n════════════════════════════════════════ *\/\n.bpt-footer {\n  border-top: 1px solid rgba(255,255,255,0.05);\n  padding: 40px 24px;\n  text-align: center;\n  max-width: 1100px;\n  margin: 0 auto;\n}\n\n.bpt-footer p {\n  font-family: 'Cinzel', serif;\n  font-size: 0.88rem;\n  letter-spacing: 0.2em;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  margin-bottom: 14px;\n}\n\n.bpt-footer span { color: var(--gold); }\n\n.bpt-footer-links {\n  display: flex;\n  gap: 20px;\n  justify-content: center;\n  flex-wrap: wrap;\n}\n\n.bpt-footer-links a {\n  font-family: 'Cinzel', serif;\n  font-size: 0.76rem;\n  letter-spacing: 0.14em;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  text-decoration: none;\n  transition: color 0.25s;\n}\n\n.bpt-footer-links a:hover { color: var(--gold); }\n\n\/* ════════════════════════════════════════\n   ANIMATIONS + RESPONSIVE\n════════════════════════════════════════ *\/\n@keyframes bptFadeUp {\n  from { opacity: 0; transform: translateY(16px); }\n  to   { opacity: 1; transform: translateY(0); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .bpt-starfield::before,\n  .bpt-hero-shield,\n  .bpt-badge .dot { animation: none; }\n  * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }\n}\n\n@media (max-width: 700px) {\n  .bpt-inner { padding: 52px 20px; }\n  .bpt-hero { padding: 72px 20px 64px; min-height: auto; }\n  .bpt-hero-shield { width: 170px; height: 170px; }\n  .bpt-cat-grid { grid-template-columns: 1fr; }\n  .bpt-product-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px; }\n  .bpt-edu-note { grid-template-columns: 1fr; text-align: center; padding: 32px 24px; }\n  .bpt-edu-icon { margin: 0 auto; }\n  .bpt-footer-links { gap: 12px; }\n}\n<\/style>\n\n<div class=\"bpt-wrap\">\n\n  <!-- ══════════ HERO ══════════ -->\n  <div class=\"bpt-hero\">\n    <div class=\"bpt-starfield\"><\/div>\n    <div class=\"bpt-hero-content\">\n      <div class=\"bpt-badge\">\n        <span class=\"dot\"><\/span>Protocol Tools\n      <\/div>\n      <p class=\"bpt-hero-eyebrow\">Soul Protocol · Spiritual Foundation<\/p>\n      <img\n        class=\"bpt-hero-shield\"\n        src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0690\/4522\/3590\/files\/soul-protocol-shield.png\"\n        alt=\"Soul Protocol Shield\"\n        width=\"220\"\n        height=\"220\"\n      >\n      <h1>Soul Protocol <span>Tools<\/span><\/h1>\n      <p class=\"bpt-hero-sub\">Support the Spiritual Foundation<\/p>\n      <p class=\"bpt-hero-desc\">Tools that support healing, inner alignment, spiritual practice, and emotional wholeness — used alongside Soul Protocol lessons to give your inner work tangible, daily expression. These tools create conditions for the deeper work. They do not do the work for you.<\/p>\n    <\/div>\n  <\/div>\n\n  <div class=\"bpt-divider\"><\/div>\n\n  <!-- ══════════ CATEGORY SECTION ══════════ -->\n  <div class=\"bpt-inner\">\n\n    <div class=\"bpt-section-label\">What's Covered<\/div>\n    <h2 class=\"bpt-section-title\">Three Areas of <span>Soul Support<\/span><\/h2>\n    <p class=\"bpt-section-desc\">Soul Protocol tools are organized around the three core areas of inner development: the physical supports that create the conditions for spiritual practice, the tools that aid emotional healing and release, and the daily-use items that ground spiritual intention into consistent, embodied habit.<\/p>\n\n    <div class=\"bpt-cat-grid\">\n\n      <div class=\"bpt-cat-card\">\n        <div class=\"bpt-cat-icon\">✨<\/div>\n        <h3>Energy &amp; Spiritual Practice<\/h3>\n        <p>Spiritual practice requires presence — and presence requires a nervous system that is regulated, a body that is settled, and an environment that supports stillness. These tools support the physical conditions that inner work depends on.<\/p>\n        <ul class=\"bpt-cat-examples\">\n          <li>Adaptogen blends for inner calm<\/li>\n          <li>Aromatherapy &amp; essential oil tools<\/li>\n          <li>Breathwork &amp; nervous system supports<\/li>\n          <li>Sound, light &amp; sensory environment tools<\/li>\n        <\/ul>\n      <\/div>\n\n      <div class=\"bpt-cat-card\">\n        <div class=\"bpt-cat-icon\">🌸<\/div>\n        <h3>Healing &amp; Release<\/h3>\n        <p>Emotional healing is not only a mental or spiritual process — it is also physical. Grief, stress, and unprocessed experience are held in the body. These tools support the physical side of emotional healing, release, and recovery.<\/p>\n        <ul class=\"bpt-cat-examples\">\n          <li>Calming herbal &amp; botanical blends<\/li>\n          <li>Skin &amp; body care for self-compassion practice<\/li>\n          <li>Sleep support for emotional processing<\/li>\n          <li>Anti-inflammatory support for stress recovery<\/li>\n        <\/ul>\n      <\/div>\n\n      <div class=\"bpt-cat-card\">\n        <div class=\"bpt-cat-icon\">🕯️<\/div>\n        <h3>Daily Ritual &amp; Intention<\/h3>\n        <p>Spiritual depth is built through daily practice, not occasional insight. These tools are designed to anchor intention into daily life — turning morning routines, self-care moments, and quiet daily habits into consistent acts of soul-level commitment.<\/p>\n        <ul class=\"bpt-cat-examples\">\n          <li>Ritual personal care &amp; body products<\/li>\n          <li>Grounding teas &amp; botanical blends<\/li>\n          <li>Journaling &amp; reflection supports<\/li>\n          <li>Daily wellness tools for consistent practice<\/li>\n        <\/ul>\n      <\/div>\n\n    <\/div>\n\n  <\/div>\n\n  <div class=\"bpt-divider\"><\/div>\n\n  <!-- ══════════ PRODUCT GRID ══════════ -->\n  <div class=\"bpt-inner\" style=\"padding-top: 64px; padding-bottom: 64px;\">\n\n    <div class=\"bpt-products-header\">\n      <div class=\"bpt-section-label centered gold\">The Tools<\/div>\n      <h2 class=\"bpt-section-title\" style=\"text-align:center;\">Soul Protocol <span class=\"gold\">Collection<\/span><\/h2>\n      <p class=\"bpt-section-desc\" style=\"margin: 0 auto 40px; text-align:center;\">Every product below is selected for alignment with Soul Protocol lessons — introduced alongside the curriculum so you understand what each tool supports and why it belongs in your practice.<\/p>\n    <\/div>\n\n    {% if collection.products.size > 0 %}\n      <div class=\"bpt-product-grid\">\n        {% for product in collection.products %}\n          <div class=\"bpt-product-item\">\n            <a href=\"{{ product.url }}\" aria-label=\"{{ product.title }}\">\n              {% if product.featured_image %}\n                <img\n                  class=\"bpt-product-img\"\n                  src=\"{{ product.featured_image | image_url: width: 600 }}\"\n                  alt=\"{{ product.featured_image.alt | escape }}\"\n                  width=\"600\"\n                  height=\"600\"\n                  loading=\"lazy\"\n                >\n              {% else %}\n                <div class=\"bpt-product-img-placeholder\">✨<\/div>\n              {% endif %}\n            <\/a>\n            <div class=\"bpt-product-info\">\n              {% if product.vendor %}\n                <span class=\"bpt-product-vendor\">{{ product.vendor }}<\/span>\n              {% endif %}\n              <div class=\"bpt-product-title\">\n                <a href=\"{{ product.url }}\">{{ product.title }}<\/a>\n              <\/div>\n              <div class=\"bpt-product-price\">\n                {% if product.price_varies %}\n                  From {{ product.price_min | money }}\n                {% else %}\n                  {{ product.price | money }}\n                {% endif %}\n              <\/div>\n              <a class=\"bpt-product-link\" href=\"{{ product.url }}\">View Tool →<\/a>\n            <\/div>\n          <\/div>\n        {% endfor %}\n      <\/div>\n    {% else %}\n      <div class=\"bpt-empty\">\n        Tools are being added to this collection — check back soon.\n      <\/div>\n    {% endif %}\n\n  <\/div>\n\n  <div class=\"bpt-divider\"><\/div>\n\n  <!-- ══════════ EDUCATIONAL NOTE ══════════ -->\n  <div class=\"bpt-inner\" style=\"padding-top: 64px; padding-bottom: 64px;\">\n\n    <div class=\"bpt-edu-note\">\n      <div class=\"bpt-edu-icon\">📚<\/div>\n      <div>\n        <h3>The Work Comes <span>From Within<\/span><\/h3>\n        <p>Every tool in this collection is introduced inside Soul Protocol lessons as a physical support for the inner work you are doing — not a substitute for it. A calming blend does not replace forgiveness practice. A ritual skin care routine does not replace honest self-reflection. These tools create the conditions that spiritual development requires.<\/p>\n        <p>Energy and practice tools appear alongside lessons on spiritual identity and purpose. Healing tools appear alongside lessons on forgiveness, release, and emotional processing. Ritual tools appear alongside lessons on daily practice, gratitude, and integrity. <strong>The inner work determines the meaning. The tools support the consistency.<\/strong><\/p>\n        <a class=\"bpt-edu-link\" href=\"\/pages\/soul\">Return to Soul Protocol →<\/a>\n      <\/div>\n    <\/div>\n\n  <\/div>\n\n  <!-- ══════════ FOOTER ══════════ -->\n  <div class=\"bpt-footer\">\n    <p>Soul Protocol Tools · <span>Healthy Kindness<\/span> · Fifth Protocol<\/p>\n    <div class=\"bpt-footer-links\">\n      <a href=\"\/\">Home<\/a>\n      <a href=\"\/pages\/body\">Body<\/a>\n      <a href=\"\/pages\/mind\">Mind<\/a>\n      <a href=\"\/pages\/soul\">Soul Protocol<\/a>\n      <a href=\"\/pages\/earth\">Earth<\/a>\n      <a href=\"\/pages\/universe\">Universe<\/a>\n      <a href=\"\/pages\/archer-institute\">The Archer Institute<\/a>\n      <a href=\"\/collections\/all\">Catalog<\/a>\n      <a href=\"\/pages\/partner-hub\">Partner Hub<\/a>\n    <\/div>\n  <\/div>\n\n<\/div>","color_scheme":"","padding_top":40,"padding_bottom":52}}},"order":["custom_liquid_EEy7CU","banner","product-grid"]}