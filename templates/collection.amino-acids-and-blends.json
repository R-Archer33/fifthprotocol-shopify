80px, 1fr));\n  gap: 16px;\n  margin-bottom: 48px;\n}\n\n.ca-standard {\n  text-align: center;\n  padding: 28px 20px;\n  background: rgba(10,25,42,0.6);\n  border: 1px solid rgba(201,168,76,0.12);\n  border-radius: 6px;\n}\n\n.ca-standard-icon { font-size: 1.8rem; margin-bottom: 10px; display: block; }\n\n.ca-standard h4 {\n  font-family: 'Cinzel', serif;\n  font-size: 0.82rem;\n  font-weight: 600;\n  color: #fff;\n  margin-bottom: 6px;\n  letter-spacing: 0.05em;\n}\n\n.ca-standard p {\n  font-size: 0.78rem;\n  line-height: 1.6;\n  color: #7a8fa6;\n}\n\n\/* ── MISSION STRIP ── *\/\n.ca-mission {\n  background: linear-gradient(135deg, rgba(124,58,237,0.08), rgba(10,25,42,0.7));\n  border: 1px solid rgba(167,139,250,0.2);\n  border-radius: 8px;\n  padding: 40px;\n  display: flex;\n  align-items: center;\n  gap: 32px;\n  margin-bottom: 32px;\n}\n\n.ca-mission-icon { font-size: 2.8rem; flex-shrink: 0; }\n\n.ca-mission h3 {\n  font-family: 'Cinzel', serif;\n  font-size: 1.2rem;\n  font-weight: 600;\n  color: #fff;\n  margin-bottom: 10px;\n}\n\n.ca-mission h3 span { color: #a78bfa; }\n\n.ca-mission p {\n  font-size: 0.95rem;\n  line-height: 1.8;\n  color: #7a8fa6;\n}\n\n.ca-mission p strong { color: #a78bfa; font-weight: 500; }\n\n\/* ── TAGLINE ── *\/\n.ca-tagline {\n  text-align: center;\n  padding: 32px 24px;\n  font-family: 'Cinzel', serif;\n  font-size: clamp(1rem, 2vw, 1.3rem);\n  font-weight: 600;\n  color: #fff;\n  letter-spacing: 0.1em;\n  border-top: 1px solid rgba(255,255,255,0.06);\n}\n\n.ca-tagline span { color: #C9A84C; }\n\n@media (max-width: 700px) {\n  .ca-source { grid-template-columns: 1fr; gap: 32px; }\n  .ca-hero-content { padding: 32px 24px; }\n  .ca-mission { flex-direction: column; text-align: center; }\n  .ca-philosophy { padding: 32px 24px; }\n}\n<\/style>\n\n<div class=\"ca-wrap\">\n\n  <!-- HERO -->\n  <div class=\"ca-hero\">\n    <div class=\"ca-hero-bg\"><\/div>\n    <div class=\"ca-hero-overlay\"><\/div>\n    <div class=\"ca-hero-wave\"><\/div>\n    <div class=\"ca-hero-content\">\n      <div class=\"ca-badge\">✦ Healthy Kindness · Performance Nutrition<\/div>\n      <h1>Amino Acids <span>&amp; Blends<\/span><\/h1>\n      <p class=\"ca-hero-sub\">Essential Aminos · Performance Support · Recovery Blends<\/p>\n      <p>The building blocks your body depends on. Amino acids are the foundation of every protein your body makes — from muscle tissue and enzymes to hormones and neurotransmitters. This collection brings together essential amino acids, targeted performance formulas, and functional blends designed to support recovery, energy, and daily function.<\/p>\n    <\/div>\n  <\/div>\n\n  <!-- SOURCE STORY -->\n  <div class=\"ca-source\">\n    <div class=\"ca-source-text\">\n      <div class=\"ca-label\">The Foundation<\/div>\n      <h2>Built from the <span>Ground Up<\/span><\/h2>\n      <p>Most people think of protein as something you eat after a workout. But the real story is deeper than that. <strong>Amino acids are the actual molecules<\/strong> that do the work — building tissue, carrying oxygen, regulating mood, supporting immune function, and fueling nearly every biological process in the human body.<\/p>\n      <p>Of the 20 amino acids the body uses, <strong>nine are essential<\/strong> — meaning your body cannot produce them on its own. They must come from what you consume. When your diet is incomplete, your body feels it — in recovery time, energy levels, mental clarity, and physical output.<\/p>\n      <p>This collection is built around the science taught in the <strong>Fifth Protocol Body curriculum<\/strong> — giving you the foundational nutrients your body needs to perform, recover, and function the way it was designed to.<\/p>\n    <\/div>\n    <div class=\"ca-source-stats\">\n      <div class=\"ca-stat\">\n        <span class=\"ca-stat-icon\">🧬<\/span>\n        <h4>9 Essential<\/h4>\n        <p>Nine amino acids the body cannot produce — must come from diet or supplementation<\/p>\n      <\/div>\n      <div class=\"ca-stat\">\n        <span class=\"ca-stat-icon\">💪<\/span>\n        <h4>Muscle &amp; Recovery<\/h4>\n        <p>Amino acids are the direct building blocks of muscle protein synthesis<\/p>\n      <\/div>\n      <div class=\"ca-stat\">\n        <span class=\"ca-stat-icon\">⚡<\/span>\n        <h4>Energy &amp; Focus<\/h4>\n        <p>Several amino acids are precursors to key neurotransmitters and energy pathways<\/p>\n      <\/div>\n      <div class=\"ca-stat\">\n        <span class=\"ca-stat-icon\">🛡️<\/span>\n        <h4>Immune Support<\/h4>\n        <p>Glutamine, arginine, and others play key roles in immune system function<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <div class=\"ca-divider\"><\/div>\n\n  <!-- PHILOSOPHY -->\n  <div class=\"ca-philosophy\">\n    <blockquote>\n      \"You cannot build a strong structure<br>\n      without the right <span>raw materials.<\/span>\"\n    <\/blockquote>\n    <cite>Amino Acids &amp; Blends · Healthy Kindness · Fifth Protocol<\/cite>\n  <\/div>\n\n  <div class=\"ca-divider\"><\/div>\n\n  <!-- CATEGORIES -->\n  <div class=\"ca-categories\">\n    <div class=\"ca-label\">What's Inside<\/div>\n    <h2>The <span>Collection<\/span><\/h2>\n    <div class=\"ca-cat-grid\">\n\n      <div class=\"ca-cat-card essential\">\n        <span class=\"ca-cat-icon\">🧬<\/span>\n        <h3>Essential Amino Acids<\/h3>\n        <p>The nine amino acids your body cannot synthesize on its own. These are the non-negotiables — the nutrients that must be present for your body to build, repair, and maintain itself at the most fundamental level.<\/p>\n        <ul class=\"ca-cat-items\">\n          <li>Histidine<\/li>\n          <li>Isoleucine<\/li>\n          <li>Leucine<\/li>\n          <li>Lysine<\/li>\n          <li>Methionine, Phenylalanine, Threonine, Tryptophan, Valine<\/li>\n        <\/ul>\n      <\/div>\n\n      <div class=\"ca-cat-card performance\">\n        <span class=\"ca-cat-icon\">⚡<\/span>\n        <h3>Performance &amp; Recovery<\/h3>\n        <p>Targeted amino acid formulas built around the specific demands of physical performance — from training and competition to daily activity and active recovery.<\/p>\n        <ul class=\"ca-cat-items\">\n          <li>BCAAs (Leucine, Isoleucine, Valine)<\/li>\n          <li>Glutamine for recovery &amp; gut health<\/li>\n          <li>Arginine for circulation &amp; pump<\/li>\n          <li>Beta-Alanine for endurance support<\/li>\n          <li>Expanding regularly<\/li>\n        <\/ul>\n      <\/div>\n\n      <div class=\"ca-cat-card blends\">\n        <span class=\"ca-cat-icon\">⚗️<\/span>\n        <h3>Functional Amino Blends<\/h3>\n        <p>Intentional combinations of amino acids formulated for specific outcomes — energy, mood support, cognitive function, immune health, and whole-body daily wellness.<\/p>\n        <ul class=\"ca-cat-items\">\n          <li>Complete EAA formulas<\/li>\n          <li>Mood &amp; cognitive support blends<\/li>\n          <li>Immune &amp; gut health formulas<\/li>\n          <li>Plant-based amino sources<\/li>\n          <li>New blends added regularly<\/li>\n        <\/ul>\n      <\/div>\n\n    <\/div>\n  <\/div>\n\n  <div class=\"ca-divider\"><\/div>\n\n  <!-- STANDARDS -->\n  <div class=\"ca-label\" style=\"font-family:'Cinzel',serif;font-size:0.72rem;letter-spacing:0.3em;color:#C9A84C;text-transform:uppercase;margin-bottom:12px;display:flex;align-items:center;gap:10px;\">\n    <span style=\"width:24px;height:1px;background:#C9A84C;display:inline-block;\"><\/span>\n    Our Standards\n  <\/div>\n  <h2 style=\"font-family:'Cinzel',serif;font-size:clamp(1.4rem,3vw,2.2rem);font-weight:600;color:#fff;margin-bottom:28px;\">\n    What We Will <span style=\"color:#C9A84C;\">Never Compromise<\/span>\n  <\/h2>\n\n  <div class=\"ca-standards\">\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">🚫<\/span>\n      <h4>No Unnecessary Fillers<\/h4>\n      <p>Every formula contains only what needs to be there. No artificial bulking agents, cheap fillers, or label dressing.<\/p>\n    <\/div>\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">🧬<\/span>\n      <h4>Bioavailable Forms<\/h4>\n      <p>We prioritize amino acid forms the body can actually absorb and use — not just the cheapest forms on the market.<\/p>\n    <\/div>\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">🔬<\/span>\n      <h4>Purposeful Formulation<\/h4>\n      <p>Every product is built around a specific function. Nothing is included without a reason, nothing removed without consideration.<\/p>\n    <\/div>\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">📖<\/span>\n      <h4>Education First<\/h4>\n      <p>Every product connects back to the Body Protocol curriculum — so you understand what you're taking and why it matters.<\/p>\n    <\/div>\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">🌱<\/span>\n      <h4>Clean Sourcing<\/h4>\n      <p>We work with suppliers who meet our standards for ingredient quality, purity, and responsible sourcing practices.<\/p>\n    <\/div>\n  <\/div>\n\n  <div class=\"ca-divider\"><\/div>\n\n  <!-- MISSION -->\n  <div class=\"ca-mission\">\n    <div class=\"ca-mission-icon\">🤝<\/div>\n    <div>\n      <h3>Every Purchase <span>Funds the Mission<\/span><\/h3>\n      <p>The Amino Acids &amp; Blends collection is powered by <strong>Healthy Kindness<\/strong> — and every product you buy supports the <strong>Fifth Protocol mission<\/strong> of educating communities with truth, empowering individuals with real tools for their health, and giving nonprofits a better way to fundraise than selling junk food.<\/p>\n    <\/div>\n  <\/div>\n\n  <!-- TAGLINE -->\n  <div class=\"ca-tagline\">\n    <span>Be True.<\/span> Live Well.\n  <\/div>\n\n<\/div>","color_scheme":"","padding_top":40,"padding_bottom":52}},"banner":{"type":"main-collection-banner","disabled":true,"settings":{"show_collection_description":true,"show_collection_image":false,"color_scheme":"scheme-1"}},"product-grid":{"type":"main-collection-product-grid","settings":{"products_per_page":24,"columns_desktop":4,"columns_mobile":"2","color_scheme":"scheme-1","image_ratio":"portrait","image_shape":"default","show_secondary_image":true,"show_vendor":false,"show_rating":false,"quick_add":"standard","enable_filtering":true,"filter_type":"horizontal","enable_sorting":true,"padding_top":0,"padding_bottom":60}}},"order":["custom_liquid_rHhq4R","banner","product-grid"]}