{"sections":{"custom_liquid_4knzYK":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n@import url('https:\/\/fonts.googleapis.com\/css2?family=Cinzel:wght@400;600;700&family=Raleway:wght@300;400;500;600;700&display=swap');\n\n.bpt-wrap {\n  --black:#080e14;\n  --gold:#C9A84C;\n  --gold-light:#f0d080;\n  --text:#e8edf2;\n  --text-muted:#9aacbe;\n  --card-bg:rgba(10,25,42,0.88);\n  --protocol-color:#4caf78;\n  --protocol-dark:#2e7d4f;\n  --protocol-darker:#1a5c35;\n  --protocol-glow:rgba(76,175,120,0.35);\n  --protocol-border:rgba(76,175,120,0.3);\n  --protocol-bg:rgba(76,175,120,0.12);\n\n  background:var(--black);\n  color:var(--text);\n  font-family:'Raleway',sans-serif;\n  line-height:1.8;\n  overflow:hidden;\n  width:100%;\n}\n\n.bpt-wrap * { box-sizing:border-box; }\n.bpt-wrap a { color:inherit; text-decoration:none; }\n.bpt-wrap img { display:block; max-width:100%; }\n\n.bpt-divider {\n  height:1px;\n  background:linear-gradient(90deg,transparent,var(--gold),transparent);\n  opacity:.3;\n}\n\n.bpt-hero {\n  position:relative;\n  min-height:78vh;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  text-align:center;\n  padding:90px 24px 80px;\n  overflow:hidden;\n}\n\n.bpt-starfield {\n  position:absolute;\n  inset:0;\n  z-index:0;\n  pointer-events:none;\n  background:\n    radial-gradient(ellipse at 18% 22%, rgba(46,125,79,.09) 0%, transparent 58%),\n    radial-gradient(ellipse at 78% 78%, rgba(11,31,58,.55) 0%, transparent 68%);\n}\n\n.bpt-starfield::before {\n  content:'';\n  position:absolute;\n  inset:0;\n  background-image:\n    radial-gradient(1.5px 1.5px at 6% 9%, rgba(255,255,255,.70) 0%, transparent 100%),\n    radial-gradient(1px 1px at 16% 28%, rgba(255,255,255,.40) 0%, transparent 100%),\n    radial-gradient(1px 1px at 24% 58%, rgba(255,255,255,.35) 0%, transparent 100%),\n    radial-gradient(1.5px 1.5px at 34% 14%, rgba(255,255,255,.55) 0%, transparent 100%),\n    radial-gradient(1px 1px at 44% 72%, rgba(255,255,255,.40) 0%, transparent 100%),\n    radial-gradient(1.5px 1.5px at 74% 46%, rgba(255,255,255,.60) 0%, transparent 100%);\n  animation:bptTwinkle 9s ease infinite alternate;\n}\n\n@keyframes bptTwinkle { from{opacity:.45;} to{opacity:1;} }\n\n.bpt-hero-content {\n  position:relative;\n  z-index:2;\n  max-width:760px;\n  margin:0 auto;\n}\n\n.bpt-badge {\n  display:inline-flex;\n  align-items:center;\n  gap:10px;\n  border:1px solid var(--protocol-border);\n  background:var(--protocol-bg);\n  border-radius:40px;\n  padding:9px 24px;\n  font-family:'Cinzel',serif;\n  font-size:.76rem;\n  letter-spacing:.22em;\n  color:var(--protocol-color);\n  text-transform:uppercase;\n  margin-bottom:26px;\n}\n\n.bpt-badge .dot {\n  width:6px;\n  height:6px;\n  border-radius:50%;\n  background:var(--protocol-color);\n  box-shadow:0 0 8px var(--protocol-color);\n}\n\n.bpt-hero-eyebrow {\n  font-family:'Cinzel',serif;\n  font-size:clamp(.68rem,1.4vw,.82rem);\n  letter-spacing:.38em;\n  color:var(--gold);\n  text-transform:uppercase;\n  margin-bottom:20px;\n}\n\n.bpt-hero-shield {\n  width:220px;\n  height:220px;\n  object-fit:contain;\n  margin:0 auto 26px;\n  filter:drop-shadow(0 0 36px var(--protocol-glow));\n  animation:bptFloat 5s ease-in-out infinite;\n}\n\n@keyframes bptFloat { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-9px);} }\n\n.bpt-hero h1 {\n  font-family:'Cinzel',serif;\n  font-size:clamp(2.4rem,6vw,5rem);\n  font-weight:700;\n  color:#fff;\n  line-height:1.05;\n  margin:0 0 12px;\n  letter-spacing:.04em;\n}\n\n.bpt-hero h1 span {\n  color:var(--protocol-color);\n  text-shadow:0 0 48px var(--protocol-glow);\n}\n\n.bpt-hero-sub {\n  font-family:'Cinzel',serif;\n  font-size:clamp(.85rem,1.8vw,1.1rem);\n  letter-spacing:.24em;\n  color:var(--gold);\n  text-transform:uppercase;\n  margin:0 0 20px;\n}\n\n.bpt-hero-desc {\n  max-width:660px;\n  margin:0 auto;\n  font-size:clamp(1rem,2vw,1.15rem);\n  line-height:1.9;\n  color:var(--text-muted);\n}\n\n.bpt-inner {\n  max-width:1100px;\n  margin:0 auto;\n  padding:72px 24px;\n}\n\n.bpt-section-label {\n  font-family:'Cinzel',serif;\n  font-size:.76rem;\n  letter-spacing:.32em;\n  color:var(--protocol-color);\n  text-transform:uppercase;\n  margin-bottom:14px;\n  display:flex;\n  align-items:center;\n  gap:12px;\n}\n\n.bpt-section-label::before {\n  content:'';\n  width:26px;\n  height:1px;\n  background:var(--protocol-color);\n  flex-shrink:0;\n}\n\n.bpt-section-label.centered {\n  justify-content:center;\n}\n\n.bpt-section-label.centered::before {\n  display:none;\n}\n\n.bpt-section-label.gold {\n  color:var(--gold);\n}\n\n.bpt-section-title {\n  font-family:'Cinzel',serif;\n  font-size:clamp(1.5rem,3.5vw,2.2rem);\n  font-weight:600;\n  color:#fff;\n  line-height:1.2;\n  margin:0 0 14px;\n}\n\n.bpt-section-title span {\n  color:var(--protocol-color);\n}\n\n.bpt-section-title span.gold {\n  color:var(--gold);\n}\n\n.bpt-section-desc {\n  font-size:1.05rem;\n  line-height:1.9;\n  color:var(--text-muted);\n  max-width:720px;\n  margin:0 0 40px;\n}\n\n.bpt-cat-grid,\n.bpt-product-grid {\n  display:grid;\n  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));\n  gap:20px;\n}\n\n.bpt-cat-card,\n.bpt-product-item {\n  background:var(--card-bg);\n  border:1px solid var(--protocol-border);\n  border-radius:6px;\n  overflow:hidden;\n  transition:transform .28s ease, box-shadow .28s ease, border-color .28s ease;\n}\n\n.bpt-cat-card {\n  padding:34px 28px;\n  position:relative;\n}\n\n.bpt-cat-card:hover,\n.bpt-product-item:hover {\n  transform:translateY(-4px);\n  box-shadow:0 12px 36px rgba(46,125,79,.14);\n  border-color:var(--protocol-color);\n}\n\n.bpt-cat-icon {\n  width:52px;\n  height:52px;\n  background:var(--protocol-bg);\n  border:1px solid var(--protocol-border);\n  border-radius:50%;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  font-size:1.4rem;\n  margin-bottom:16px;\n}\n\n.bpt-cat-card h3 {\n  font-family:'Cinzel',serif;\n  font-size:1.05rem;\n  color:var(--protocol-color);\n  margin:0 0 10px;\n  letter-spacing:.04em;\n}\n\n.bpt-cat-card p {\n  font-size:.92rem;\n  line-height:1.78;\n  color:var(--text-muted);\n  margin:0 0 18px;\n}\n\n.bpt-cat-examples {\n  list-style:none;\n  margin:0;\n  padding:0;\n}\n\n.bpt-cat-examples li {\n  font-size:.82rem;\n  color:var(--text-muted);\n  padding:5px 0;\n  border-bottom:1px solid rgba(255,255,255,.04);\n  display:flex;\n  gap:9px;\n}\n\n.bpt-cat-examples li::before {\n  content:'◆';\n  font-size:.38rem;\n  color:var(--protocol-color);\n  flex-shrink:0;\n}\n\n.bpt-products-header {\n  text-align:center;\n  margin-bottom:36px;\n}\n\n.bpt-product-img,\n.bpt-product-img-placeholder {\n  width:100%;\n  aspect-ratio:1 \/ 1;\n  object-fit:cover;\n  background:rgba(10,25,42,.6);\n}\n\n.bpt-product-img-placeholder {\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  font-size:3rem;\n}\n\n.bpt-product-info {\n  padding:18px 20px;\n}\n\n.bpt-product-vendor {\n  display:block;\n  font-family:'Cinzel',serif;\n  font-size:.72rem;\n  letter-spacing:.18em;\n  color:var(--protocol-color);\n  text-transform:uppercase;\n  margin-bottom:8px;\n}\n\n.bpt-product-title {\n  font-family:'Cinzel',serif;\n  font-size:.9rem;\n  font-weight:600;\n  color:#fff;\n  letter-spacing:.04em;\n  line-height:1.35;\n  margin-bottom:8px;\n}\n\n.bpt-product-price {\n  font-family:'Cinzel',serif;\n  font-size:.88rem;\n  color:var(--gold);\n  margin-bottom:12px;\n}\n\n.bpt-product-link {\n  display:block;\n  text-align:center;\n  padding:10px 16px;\n  background:linear-gradient(135deg,var(--protocol-dark),var(--protocol-darker));\n  color:#fff !important;\n  font-family:'Cinzel',serif;\n  font-size:.68rem;\n  letter-spacing:.18em;\n  text-transform:uppercase;\n  border-radius:3px;\n  border:1px solid var(--protocol-border);\n}\n\n.bpt-empty {\n  text-align:center;\n  padding:60px 24px;\n  color:var(--text-muted);\n  font-family:'Cinzel',serif;\n  font-size:.9rem;\n  letter-spacing:.12em;\n  border:1px dashed rgba(255,255,255,.1);\n  border-radius:6px;\n}\n\n.bpt-edu-note {\n  background:linear-gradient(135deg,rgba(46,125,79,.07),rgba(10,25,42,.75));\n  border:1px solid var(--protocol-border);\n  border-radius:6px;\n  padding:44px 40px;\n  display:grid;\n  grid-template-columns:auto 1fr;\n  gap:28px;\n}\n\n.bpt-edu-icon {\n  width:56px;\n  height:56px;\n  background:var(--protocol-bg);\n  border:1px solid var(--protocol-border);\n  border-radius:50%;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  font-size:1.5rem;\n}\n\n.bpt-edu-note h3 {\n  font-family:'Cinzel',serif;\n  font-size:clamp(1rem,2.5vw,1.3rem);\n  color:#fff;\n  margin:0 0 12px;\n}\n\n.bpt-edu-note h3 span {\n  color:var(--protocol-color);\n}\n\n.bpt-edu-note p {\n  font-size:.98rem;\n  line-height:1.88;\n  color:var(--text-muted);\n  margin:0 0 14px;\n}\n\n.bpt-edu-note strong {\n  color:var(--text);\n}\n\n.bpt-edu-link {\n  display:inline-flex;\n  font-family:'Cinzel',serif;\n  font-size:.72rem;\n  letter-spacing:.2em;\n  color:var(--protocol-color);\n  text-transform:uppercase;\n  margin-top:6px;\n}\n\n.bpt-footer {\n  border-top:1px solid rgba(255,255,255,.05);\n  padding:40px 24px;\n  text-align:center;\n  max-width:1100px;\n  margin:0 auto;\n}\n\n.bpt-footer p {\n  font-family:'Cinzel',serif;\n  font-size:.88rem;\n  letter-spacing:.2em;\n  color:var(--text-muted);\n  text-transform:uppercase;\n  margin:0 0 14px;\n}\n\n.bpt-footer span {\n  color:var(--gold);\n}\n\n.bpt-footer-links {\n  display:flex;\n  gap:20px;\n  justify-content:center;\n  flex-wrap:wrap;\n}\n\n.bpt-footer-links a {\n  font-family:'Cinzel',serif;\n  font-size:.76rem;\n  letter-spacing:.14em;\n  color:var(--text-muted);\n  text-transform:uppercase;\n}\n\n@media (prefers-reduced-motion:reduce) {\n  .bpt-starfield::before,\n  .bpt-hero-shield {\n    animation:none;\n  }\n}\n\n@media (max-width:700px) {\n  .bpt-inner { padding:52px 20px; }\n  .bpt-hero { padding:72px 20px 64px; min-height:auto; }\n  .bpt-hero-shield { width:170px; height:170px; }\n  .bpt-cat-grid,\n  .bpt-product-grid { grid-template-columns:1fr; }\n  .bpt-edu-note { grid-template-columns:1fr; text-align:center; padding:32px 24px; }\n  .bpt-edu-icon { margin:0 auto; }\n}\n<\/style>\n\n<div class=\"bpt-wrap\">\n\n  <div class=\"bpt-hero\">\n    <div class=\"bpt-starfield\"><\/div>\n    <div class=\"bpt-hero-content\">\n      <div class=\"bpt-badge\"><span class=\"dot\"><\/span>Protocol Tools<\/div>\n      <p class=\"bpt-hero-eyebrow\">Body Protocol · Physical Foundation<\/p>\n\n      <img\n        class=\"bpt-hero-shield\"\n        src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0690\/4522\/3590\/files\/Gemini_Generated_Image_bbansxbbansxbban.png?v=1777668360\"\n        alt=\"Body Protocol Shield\"\n        width=\"220\"\n        height=\"220\"\n      >\n\n      <h1>Body Protocol <span>Tools<\/span><\/h1>\n      <p class=\"bpt-hero-sub\">Support the Physical Foundation<\/p>\n      <p class=\"bpt-hero-desc\">\n        Tools that support hydration, minerals, recovery, movement, nourishment, and daily body care. These tools are used alongside Body Protocol lessons to support real-world application. They complement education. They do not replace it.\n      <\/p>\n    <\/div>\n  <\/div>\n\n  <div class=\"bpt-divider\"><\/div>\n\n  <div class=\"bpt-inner\">\n    <div class=\"bpt-section-label\">What's Covered<\/div>\n    <h2 class=\"bpt-section-title\">Three Areas of <span>Physical Support<\/span><\/h2>\n    <p class=\"bpt-section-desc\">\n      Body Protocol tools are organized around the three core areas of physical resilience: hydration and mineral balance, recovery and repair, and daily nourishment for performance.\n    <\/p>\n\n    <div class=\"bpt-cat-grid\">\n      <div class=\"bpt-cat-card\">\n        <div class=\"bpt-cat-icon\">💧<\/div>\n        <h3>Hydration &amp; Minerals<\/h3>\n        <p>The body depends on water, minerals, and cellular absorption — hydration is more than drinking more water.<\/p>\n        <ul class=\"bpt-cat-examples\">\n          <li>Sea moss and trace mineral sources<\/li>\n          <li>Electrolyte support<\/li>\n          <li>Structured hydration tools<\/li>\n          <li>Mineral-rich botanical blends<\/li>\n        <\/ul>\n      <\/div>\n\n      <div class=\"bpt-cat-card\">\n        <div class=\"bpt-cat-icon\">🌙<\/div>\n        <h3>Recovery &amp; Repair<\/h3>\n        <p>The body does not grow during exertion — it grows during recovery, repair, sleep, and restoration.<\/p>\n        <ul class=\"bpt-cat-examples\">\n          <li>Adaptogen and recovery blends<\/li>\n          <li>Inflammation-support tools<\/li>\n          <li>Sleep and nervous system tools<\/li>\n          <li>Topical recovery support<\/li>\n        <\/ul>\n      <\/div>\n\n      <div class=\"bpt-cat-card\">\n        <div class=\"bpt-cat-icon\">🌿<\/div>\n        <h3>Nourishment &amp; Performance<\/h3>\n        <p>Daily nourishment supports energy, micronutrient intake, recovery, and the biological systems that govern performance.<\/p>\n        <ul class=\"bpt-cat-examples\">\n          <li>Protein and amino sources<\/li>\n          <li>Vitamins, minerals, and daily foundations<\/li>\n          <li>Natural extracts and functional blends<\/li>\n          <li>Body care and skin support<\/li>\n        <\/ul>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <div class=\"bpt-divider\"><\/div>\n\n  <div class=\"bpt-inner\">\n    <div class=\"bpt-products-header\">\n      <div class=\"bpt-section-label centered gold\">The Tools<\/div>\n      <h2 class=\"bpt-section-title\">Body Protocol <span class=\"gold\">Collection<\/span><\/h2>\n      <p class=\"bpt-section-desc\" style=\"margin-left:auto;margin-right:auto;text-align:center;\">\n        Every product below is selected for alignment with Body Protocol lessons. Use them as physical supports for the knowledge you are building — not as substitutes for it.\n      <\/p>\n    <\/div>\n\n    {% if collection and collection.products_count > 0 %}\n      <div class=\"bpt-product-grid\">\n        {% paginate collection.products by 24 %}\n          {% for product in collection.products %}\n            <div class=\"bpt-product-item\">\n              <a href=\"{{ product.url | within: collection }}\">\n                {% if product.featured_image %}\n                  <img\n                    class=\"bpt-product-img\"\n                    src=\"{{ product.featured_image | image_url: width: 600 }}\"\n                    alt=\"{{ product.featured_image.alt | default: product.title | escape }}\"\n                    width=\"600\"\n                    height=\"600\"\n                    loading=\"lazy\"\n                  >\n                {% else %}\n                  <div class=\"bpt-product-img-placeholder\">🌿<\/div>\n                {% endif %}\n              <\/a>\n\n              <div class=\"bpt-product-info\">\n                {% if product.vendor != blank %}\n                  <span class=\"bpt-product-vendor\">{{ product.vendor }}<\/span>\n                {% endif %}\n\n                <div class=\"bpt-product-title\">\n                  <a href=\"{{ product.url | within: collection }}\">{{ product.title }}<\/a>\n                <\/div>\n\n                <div class=\"bpt-product-price\">\n                  {% if product.price_varies %}\n                    From {{ product.price_min | money }}\n                  {% else %}\n                    {{ product.price | money }}\n                  {% endif %}\n                <\/div>\n\n                <a class=\"bpt-product-link\" href=\"{{ product.url | within: collection }}\">View Tool →<\/a>\n              <\/div>\n            <\/div>\n          {% endfor %}\n\n          {% if paginate.pages > 1 %}\n            <div style=\"grid-column:1\/-1;text-align:center;margin-top:24px;\">\n              {{ paginate | default_pagination }}\n            <\/div>\n          {% endif %}\n        {% endpaginate %}\n      <\/div>\n    {% else %}\n      <div class=\"bpt-empty\">Tools are being added to this collection — check back soon.<\/div>\n    {% endif %}\n  <\/div>\n\n  <div class=\"bpt-divider\"><\/div>\n\n  <div class=\"bpt-inner\">\n    <div class=\"bpt-edu-note\">\n      <div class=\"bpt-edu-icon\">📚<\/div>\n      <div>\n        <h3>Tools Follow <span>Understanding<\/span><\/h3>\n        <p>Every tool in this collection is introduced inside Body Protocol lessons as a practical support for what you are learning. The purpose is to give students tangible ways to apply knowledge into daily physical life.<\/p>\n        <p>Hydration tools appear alongside lessons on mineral balance. Recovery tools appear alongside lessons on sleep and repair cycles. Nourishment tools appear alongside lessons on nutrition and food science. <strong>Understanding comes first. Tools follow.<\/strong><\/p>\n        <a class=\"bpt-edu-link\" href=\"\/pages\/body\">Return to Body Protocol →<\/a>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <div class=\"bpt-footer\">\n    <p>Body Protocol Tools · <span>Healthy Kindness<\/span> · Fifth Protocol<\/p>\n    <div class=\"bpt-footer-links\">\n      <a href=\"\/\">Home<\/a>\n      <a href=\"\/pages\/body\">Body Protocol<\/a>\n      <a href=\"\/pages\/mind\">Mind<\/a>\n      <a href=\"\/pages\/soul\">Soul<\/a>\n      <a href=\"\/pages\/earth\">Earth<\/a>\n      <a href=\"\/pages\/universe\">Universe<\/a>\n      <a href=\"\/pages\/archer-institute\">The Archer Institute<\/a>\n      <a href=\"\/collections\/all\">All Tools<\/a>\n      <a href=\"\/pages\/partner-hub\">Partner Hub<\/a>\n    <\/div>\n  <\/div>\n\n<\/div>","color_scheme":"","padding_top":40,"padding_bottom":52}},"banner":{"type":"main-collection-banner","settings":{"show_collection_description":true,"show_collection_image":false,"color_scheme":"scheme-1"}},"product-grid":{"type":"main-collection-product-grid","settings":{"products_per_page":24,"columns_desktop":4,"columns_mobile":"2","color_scheme":"scheme-1","image_ratio":"portrait","image_shape":"default","show_secondary_image":true,"show_vendor":false,"show_rating":false,"quick_add":"standard","enable_filtering":true,"filter_type":"horizontal","enable_sorting":true,"padding_top":0,"padding_bottom":60}}},"order":["custom_liquid_4knzYK","banner","product-grid"]}