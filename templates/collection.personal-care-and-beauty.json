{"sections":{"custom_liquid_GkrnLg":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<style>\n@import url('https:\/\/fonts.googleapis.com\/css2?family=Cinzel:wght@400;600;700&family=Raleway:wght@300;400;500;600&display=swap');\n\n.ca-wrap {\n  background: #080e14;\n  color: #d8e0e8;\n  font-family: 'Raleway', sans-serif;\n  font-weight: 300;\n  padding: 0;\n}\n\n.ca-wrap * { box-sizing: border-box; margin: 0; padding: 0; }\n\n\/* ── HERO ── *\/\n.ca-hero {\n  position: relative;\n  min-height: 420px;\n  display: flex;\n  align-items: flex-end;\n  border-radius: 8px;\n  overflow: hidden;\n  margin-bottom: 48px;\n}\n\n.ca-hero-bg {\n  position: absolute;\n  inset: 0;\n  background:\n    radial-gradient(ellipse at 20% 50%, rgba(183,110,121,0.14) 0%, transparent 60%),\n    radial-gradient(ellipse at 80% 20%, rgba(201,168,76,0.08) 0%, transparent 50%),\n    linear-gradient(135deg, #060d18 0%, #140a10 50%, #060d18 100%);\n}\n\n.ca-hero-overlay {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(to top, rgba(8,14,20,0.95) 0%, rgba(8,14,20,0.4) 60%, transparent 100%);\n}\n\n.ca-hero-wave {\n  position: absolute;\n  top: 0; left: 0; right: 0;\n  height: 3px;\n  background: linear-gradient(90deg, transparent, #b76e79, #e8a598, #C9A84C, transparent);\n  opacity: 0.6;\n}\n\n.ca-hero-content {\n  position: relative;\n  z-index: 1;\n  padding: 48px 40px;\n  width: 100%;\n}\n\n.ca-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  background: rgba(183,110,121,0.12);\n  border: 1px solid rgba(183,110,121,0.28);\n  border-radius: 30px;\n  padding: 7px 20px;\n  font-family: 'Cinzel', serif;\n  font-size: 0.72rem;\n  letter-spacing: 0.25em;\n  color: #e8a598;\n  text-transform: uppercase;\n  margin-bottom: 20px;\n}\n\n.ca-hero h1 {\n  font-family: 'Cinzel', serif;\n  font-size: clamp(2.2rem, 6vw, 4rem);\n  font-weight: 700;\n  color: #fff;\n  line-height: 1.1;\n  margin-bottom: 8px;\n}\n\n.ca-hero h1 span { color: #C9A84C; text-shadow: 0 0 40px rgba(201,168,76,0.3); }\n\n.ca-hero-sub {\n  font-family: 'Cinzel', serif;\n  font-size: clamp(0.8rem, 1.5vw, 1rem);\n  letter-spacing: 0.25em;\n  color: #e8a598;\n  text-transform: uppercase;\n  margin-bottom: 20px;\n}\n\n.ca-hero p {\n  font-size: clamp(1rem, 1.8vw, 1.15rem);\n  line-height: 1.9;\n  color: #7a8fa6;\n  max-width: 620px;\n}\n\n\/* ── GOLD DIVIDER ── *\/\n.ca-divider {\n  width: 100%;\n  height: 1px;\n  background: linear-gradient(90deg, transparent, #C9A84C, transparent);\n  opacity: 0.3;\n  margin: 40px 0;\n}\n\n\/* ── SOURCE STORY ── *\/\n.ca-source {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 48px;\n  align-items: center;\n  margin-bottom: 48px;\n}\n\n.ca-source-text .ca-label {\n  font-family: 'Cinzel', serif;\n  font-size: 0.72rem;\n  letter-spacing: 0.3em;\n  color: #C9A84C;\n  text-transform: uppercase;\n  margin-bottom: 12px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n.ca-source-text .ca-label::before { content: ''; width: 24px; height: 1px; background: #C9A84C; }\n\n.ca-source-text h2 {\n  font-family: 'Cinzel', serif;\n  font-size: clamp(1.4rem, 3vw, 2.2rem);\n  font-weight: 600;\n  color: #fff;\n  margin-bottom: 20px;\n  line-height: 1.2;\n}\n.ca-source-text h2 span { color: #e8a598; }\n\n.ca-source-text p {\n  font-size: 1rem;\n  line-height: 1.9;\n  color: #7a8fa6;\n  margin-bottom: 16px;\n}\n\n.ca-source-text p strong { color: #d8e0e8; font-weight: 500; }\n\n.ca-source-stats {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 16px;\n}\n\n.ca-stat {\n  background: rgba(10,25,42,0.85);\n  border: 1px solid rgba(201,168,76,0.15);\n  border-radius: 6px;\n  padding: 24px 20px;\n  text-align: center;\n}\n\n.ca-stat-icon { font-size: 1.8rem; margin-bottom: 8px; display: block; }\n\n.ca-stat h4 {\n  font-family: 'Cinzel', serif;\n  font-size: 0.85rem;\n  font-weight: 600;\n  color: #fff;\n  margin-bottom: 4px;\n}\n\n.ca-stat p {\n  font-size: 0.8rem;\n  color: #7a8fa6;\n  line-height: 1.5;\n}\n\n\/* ── PHILOSOPHY ── *\/\n.ca-philosophy {\n  background: linear-gradient(135deg, rgba(183,110,121,0.06), rgba(10,25,42,0.8));\n  border: 1px solid rgba(183,110,121,0.15);\n  border-radius: 8px;\n  padding: 48px 40px;\n  margin-bottom: 48px;\n  text-align: center;\n}\n\n.ca-philosophy blockquote {\n  font-family: 'Cinzel', serif;\n  font-size: clamp(1.2rem, 3vw, 1.8rem);\n  font-weight: 400;\n  color: #fff;\n  line-height: 1.6;\n  margin-bottom: 16px;\n  font-style: italic;\n}\n\n.ca-philosophy blockquote span { color: #C9A84C; }\n\n.ca-philosophy cite {\n  font-family: 'Cinzel', serif;\n  font-size: 0.75rem;\n  letter-spacing: 0.25em;\n  color: #e8a598;\n  text-transform: uppercase;\n  font-style: normal;\n}\n\n\/* ── COLLECTION CATEGORIES ── *\/\n.ca-categories {\n  margin-bottom: 48px;\n}\n\n.ca-categories .ca-label {\n  font-family: 'Cinzel', serif;\n  font-size: 0.72rem;\n  letter-spacing: 0.3em;\n  color: #C9A84C;\n  text-transform: uppercase;\n  margin-bottom: 12px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n.ca-categories .ca-label::before { content: ''; width: 24px; height: 1px; background: #C9A84C; }\n\n.ca-categories h2 {\n  font-family: 'Cinzel', serif;\n  font-size: clamp(1.4rem, 3vw, 2.2rem);\n  font-weight: 600;\n  color: #fff;\n  margin-bottom: 32px;\n}\n.ca-categories h2 span { color: #C9A84C; }\n\n.ca-cat-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n  gap: 20px;\n}\n\n.ca-cat-card {\n  background: rgba(10,25,42,0.85);\n  border-radius: 6px;\n  padding: 32px 28px;\n  border: 1px solid rgba(255,255,255,0.06);\n  transition: all 0.3s ease;\n  position: relative;\n  overflow: hidden;\n}\n\n.ca-cat-card::before {\n  content: '';\n  position: absolute;\n  bottom: 0; left: 0; right: 0;\n  height: 2px;\n  opacity: 0;\n  transition: opacity 0.3s ease;\n}\n\n.ca-cat-card:hover { transform: translateY(-4px); }\n.ca-cat-card:hover::before { opacity: 1; }\n\n.ca-cat-card.skin { border-color: rgba(232,165,152,0.2); }\n.ca-cat-card.skin::before { background: linear-gradient(90deg, transparent, #e8a598, transparent); }\n.ca-cat-card.skin:hover { border-color: #e8a598; box-shadow: 0 12px 40px rgba(183,110,121,0.15); }\n\n.ca-cat-card.hair { border-color: rgba(201,168,76,0.2); }\n.ca-cat-card.hair::before { background: linear-gradient(90deg, transparent, #C9A84C, transparent); }\n.ca-cat-card.hair:hover { border-color: #C9A84C; box-shadow: 0 12px 40px rgba(139,94,26,0.15); }\n\n.ca-cat-card.body { border-color: rgba(76,175,120,0.2); }\n.ca-cat-card.body::before { background: linear-gradient(90deg, transparent, #4caf78, transparent); }\n.ca-cat-card.body:hover { border-color: #4caf78; box-shadow: 0 12px 40px rgba(46,125,79,0.15); }\n\n.ca-cat-icon { font-size: 2.2rem; margin-bottom: 16px; display: block; }\n\n.ca-cat-card h3 {\n  font-family: 'Cinzel', serif;\n  font-size: 1.1rem;\n  font-weight: 600;\n  color: #fff;\n  margin-bottom: 10px;\n}\n\n.ca-cat-card.skin h3 { color: #e8a598; }\n.ca-cat-card.hair h3 { color: #C9A84C; }\n.ca-cat-card.body h3 { color: #4caf78; }\n\n.ca-cat-card p {\n  font-size: 0.9rem;\n  line-height: 1.7;\n  color: #7a8fa6;\n  margin-bottom: 16px;\n}\n\n.ca-cat-items {\n  list-style: none;\n  padding: 0;\n}\n\n.ca-cat-items li {\n  font-size: 0.82rem;\n  color: #7a8fa6;\n  padding: 4px 0;\n  border-bottom: 1px solid rgba(255,255,255,0.04);\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.ca-cat-items li::before {\n  content: '';\n  width: 4px;\n  height: 4px;\n  border-radius: 50%;\n  flex-shrink: 0;\n}\n\n.ca-cat-card.skin .ca-cat-items li::before { background: #e8a598; }\n.ca-cat-card.hair .ca-cat-items li::before { background: #C9A84C; }\n.ca-cat-card.body .ca-cat-items li::before { background: #4caf78; }\n\n\/* ── STANDARDS ── *\/\n.ca-standards {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n  gap: 16px;\n  margin-bottom: 48px;\n}\n\n.ca-standard {\n  text-align: center;\n  padding: 28px 20px;\n  background: rgba(10,25,42,0.6);\n  border: 1px solid rgba(201,168,76,0.12);\n  border-radius: 6px;\n}\n\n.ca-standard-icon { font-size: 1.8rem; margin-bottom: 10px; display: block; }\n\n.ca-standard h4 {\n  font-family: 'Cinzel', serif;\n  font-size: 0.82rem;\n  font-weight: 600;\n  color: #fff;\n  margin-bottom: 6px;\n  letter-spacing: 0.05em;\n}\n\n.ca-standard p {\n  font-size: 0.78rem;\n  line-height: 1.6;\n  color: #7a8fa6;\n}\n\n\/* ── MISSION STRIP ── *\/\n.ca-mission {\n  background: linear-gradient(135deg, rgba(183,110,121,0.07), rgba(10,25,42,0.7));\n  border: 1px solid rgba(183,110,121,0.2);\n  border-radius: 8px;\n  padding: 40px;\n  display: flex;\n  align-items: center;\n  gap: 32px;\n  margin-bottom: 32px;\n}\n\n.ca-mission-icon { font-size: 2.8rem; flex-shrink: 0; }\n\n.ca-mission h3 {\n  font-family: 'Cinzel', serif;\n  font-size: 1.2rem;\n  font-weight: 600;\n  color: #fff;\n  margin-bottom: 10px;\n}\n\n.ca-mission h3 span { color: #e8a598; }\n\n.ca-mission p {\n  font-size: 0.95rem;\n  line-height: 1.8;\n  color: #7a8fa6;\n}\n\n.ca-mission p strong { color: #e8a598; font-weight: 500; }\n\n\/* ── TAGLINE ── *\/\n.ca-tagline {\n  text-align: center;\n  padding: 32px 24px;\n  font-family: 'Cinzel', serif;\n  font-size: clamp(1rem, 2vw, 1.3rem);\n  font-weight: 600;\n  color: #fff;\n  letter-spacing: 0.1em;\n  border-top: 1px solid rgba(255,255,255,0.06);\n}\n\n.ca-tagline span { color: #C9A84C; }\n\n@media (max-width: 700px) {\n  .ca-source { grid-template-columns: 1fr; gap: 32px; }\n  .ca-hero-content { padding: 32px 24px; }\n  .ca-mission { flex-direction: column; text-align: center; }\n  .ca-philosophy { padding: 32px 24px; }\n}\n<\/style>\n\n<div class=\"ca-wrap\">\n\n  <!-- HERO -->\n  <div class=\"ca-hero\">\n    <div class=\"ca-hero-bg\"><\/div>\n    <div class=\"ca-hero-overlay\"><\/div>\n    <div class=\"ca-hero-wave\"><\/div>\n    <div class=\"ca-hero-content\">\n      <div class=\"ca-badge\">✦ Healthy Kindness · Clean Beauty<\/div>\n      <h1>Personal Care <span>&amp; Beauty<\/span><\/h1>\n      <p class=\"ca-hero-sub\">Skin Care · Hair Care · Body &amp; Wellness<\/p>\n      <p>What you put on your body matters as much as what you put in it. This collection brings together clean, botanically-informed personal care — skin care, hair care, and body products formulated with real ingredients, built around the same standards of quality and intention that run through everything Healthy Kindness makes.<\/p>\n    <\/div>\n  <\/div>\n\n  <!-- SOURCE STORY -->\n  <div class=\"ca-source\">\n    <div class=\"ca-source-text\">\n      <div class=\"ca-label\">The Philosophy<\/div>\n      <h2>Beauty from the <span>Inside Out<\/span><\/h2>\n      <p>The personal care industry is one of the least regulated spaces in consumer products. Ingredients that would never be approved for food are routinely found in lotions, shampoos, and skin treatments — absorbed through the skin and into the body every single day.<\/p>\n      <p>We built this collection around a simple standard: <strong>if we wouldn't put it in our bodies, we won't put it on them either.<\/strong> Every product here is formulated with botanicals, plant-derived actives, and clean carriers — chosen for what they do, not for how cheap they are.<\/p>\n      <p>True beauty is an expression of health. This collection is built to support both — connecting to the <strong>Fifth Protocol Body curriculum<\/strong> and the RoyaLegacy skincare philosophy of nourishing the skin you're in.<\/p>\n    <\/div>\n    <div class=\"ca-source-stats\">\n      <div class=\"ca-stat\">\n        <span class=\"ca-stat-icon\">🌿<\/span>\n        <h4>Botanical First<\/h4>\n        <p>Plant-derived actives and botanicals lead every formulation — not synthetic fillers<\/p>\n      <\/div>\n      <div class=\"ca-stat\">\n        <span class=\"ca-stat-icon\">🚫<\/span>\n        <h4>No Harsh Chemicals<\/h4>\n        <p>Free from parabens, sulfates, synthetic fragrances, and unnecessary harsh additives<\/p>\n      <\/div>\n      <div class=\"ca-stat\">\n        <span class=\"ca-stat-icon\">🌊<\/span>\n        <h4>Sea Moss Infused<\/h4>\n        <p>Many products incorporate the mineral-rich benefits of Irish Moss for skin and hair<\/p>\n      <\/div>\n      <div class=\"ca-stat\">\n        <span class=\"ca-stat-icon\">✨<\/span>\n        <h4>Clean &amp; Intentional<\/h4>\n        <p>Every ingredient is included for a reason — and every product is designed to actually work<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <div class=\"ca-divider\"><\/div>\n\n  <!-- PHILOSOPHY -->\n  <div class=\"ca-philosophy\">\n    <blockquote>\n      \"Your skin is not a barrier to work around —<br>\n      it is a living organ <span>worthy of real care.<\/span>\"\n    <\/blockquote>\n    <cite>Personal Care &amp; Beauty · Healthy Kindness · Fifth Protocol<\/cite>\n  <\/div>\n\n  <div class=\"ca-divider\"><\/div>\n\n  <!-- CATEGORIES -->\n  <div class=\"ca-categories\">\n    <div class=\"ca-label\">What's Inside<\/div>\n    <h2>The <span>Collection<\/span><\/h2>\n    <div class=\"ca-cat-grid\">\n\n      <div class=\"ca-cat-card skin\">\n        <span class=\"ca-cat-icon\">✨<\/span>\n        <h3>Skin Care<\/h3>\n        <p>Clean, botanically-driven skin care formulated to nourish, protect, and support the skin's natural function — without stripping it, overloading it with synthetics, or making promises it can't keep.<\/p>\n        <ul class=\"ca-cat-items\">\n          <li>Sea moss gel face masks &amp; treatments<\/li>\n          <li>Moisturizers &amp; serums<\/li>\n          <li>Cleansers &amp; toners<\/li>\n          <li>RoyaLegacy Collection formulas<\/li>\n          <li>Expanding regularly<\/li>\n        <\/ul>\n      <\/div>\n\n      <div class=\"ca-cat-card hair\">\n        <span class=\"ca-cat-icon\">💫<\/span>\n        <h3>Hair Care<\/h3>\n        <p>Hair health starts at the scalp — and the scalp responds to the same botanical intelligence as the skin. This range supports moisture, strength, and scalp health with plant-based formulas free from harsh stripping agents.<\/p>\n        <ul class=\"ca-cat-items\">\n          <li>Scalp treatments &amp; oils<\/li>\n          <li>Conditioning &amp; moisture formulas<\/li>\n          <li>Sea moss &amp; herbal hair blends<\/li>\n          <li>Sulfate-free cleansing options<\/li>\n          <li>New products added regularly<\/li>\n        <\/ul>\n      <\/div>\n\n      <div class=\"ca-cat-card body\">\n        <span class=\"ca-cat-icon\">🌿<\/span>\n        <h3>Body &amp; Wellness<\/h3>\n        <p>Personal care that goes beyond skin deep — body butters, soaps, wellness blends, and daily-use products that treat your body as the living system it is, not just a surface to be cleaned.<\/p>\n        <ul class=\"ca-cat-items\">\n          <li>Body butters &amp; moisturizers<\/li>\n          <li>Natural soaps &amp; cleansers<\/li>\n          <li>Essential oil &amp; botanical blends<\/li>\n          <li>Deodorants &amp; personal hygiene<\/li>\n          <li>Collection growing continuously<\/li>\n        <\/ul>\n      <\/div>\n\n    <\/div>\n  <\/div>\n\n  <div class=\"ca-divider\"><\/div>\n\n  <!-- STANDARDS -->\n  <div class=\"ca-label\" style=\"font-family:'Cinzel',serif;font-size:0.72rem;letter-spacing:0.3em;color:#C9A84C;text-transform:uppercase;margin-bottom:12px;display:flex;align-items:center;gap:10px;\">\n    <span style=\"width:24px;height:1px;background:#C9A84C;display:inline-block;\"><\/span>\n    Our Standards\n  <\/div>\n  <h2 style=\"font-family:'Cinzel',serif;font-size:clamp(1.4rem,3vw,2.2rem);font-weight:600;color:#fff;margin-bottom:28px;\">\n    What We Will <span style=\"color:#C9A84C;\">Never Compromise<\/span>\n  <\/h2>\n\n  <div class=\"ca-standards\">\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">🚫<\/span>\n      <h4>No Parabens or Sulfates<\/h4>\n      <p>Preservatives and cleansing agents known to disrupt hormones and strip the skin's natural barrier are never used.<\/p>\n    <\/div>\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">🌸<\/span>\n      <h4>No Synthetic Fragrance<\/h4>\n      <p>Synthetic fragrance is one of the most common hidden irritants in personal care. We use only natural scent sources.<\/p>\n    <\/div>\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">🌿<\/span>\n      <h4>Botanical Actives<\/h4>\n      <p>Real plant ingredients — not the trace amounts used for marketing. Botanicals are the backbone of every formula.<\/p>\n    <\/div>\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">🔬<\/span>\n      <h4>Purposeful Formulation<\/h4>\n      <p>Every ingredient earns its place. Nothing is added for appearance, cost savings, or trend — only for function.<\/p>\n    <\/div>\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">📖<\/span>\n      <h4>Education First<\/h4>\n      <p>Every product connects to the Fifth Protocol Body curriculum — because understanding what you use is part of real self-care.<\/p>\n    <\/div>\n  <\/div>\n\n  <div class=\"ca-divider\"><\/div>\n\n  <!-- MISSION -->\n  <div class=\"ca-mission\">\n    <div class=\"ca-mission-icon\">🤝<\/div>\n    <div>\n      <h3>Every Purchase <span>Funds the Mission<\/span><\/h3>\n      <p>The Personal Care &amp; Beauty collection is powered by <strong>Healthy Kindness<\/strong> — and every product you buy supports the <strong>Fifth Protocol mission<\/strong> of educating communities with truth, empowering individuals with real tools for their health, and giving nonprofits a better way to fundraise than selling junk food.<\/p>\n    <\/div>\n  <\/div>\n\n  <!-- TAGLINE -->\n  <div class=\"ca-tagline\">\n    <span>Be True.<\/span> Live Well.\n  <\/div>\n\n<\/div>","color_scheme":"","padding_top":40,"padding_bottom":52}},"banner":{"type":"main-collection-banner","disabled":true,"settings":{"show_collection_description":true,"show_collection_image":false,"color_scheme":"scheme-1"}},"product-grid":{"type":"main-collection-product-grid","settings":{"products_per_page":24,"columns_desktop":4,"columns_mobile":"2","color_scheme":"scheme-1","image_ratio":"portrait","image_shape":"default","show_secondary_image":true,"show_vendor":false,"show_rating":false,"quick_add":"standard","enable_filtering":true,"filter_type":"horizontal","enable_sorting":true,"padding_top":0,"padding_bottom":60}}},"order":["custom_liquid_GkrnLg","banner","product-grid"]}