x;\n}\n\n.ca-standard {\n  text-align: center;\n  padding: 28px 20px;\n  background: rgba(10,25,42,0.6);\n  border: 1px solid rgba(201,168,76,0.12);\n  border-radius: 6px;\n}\n\n.ca-standard-icon { font-size: 1.8rem; margin-bottom: 10px; display: block; }\n\n.ca-standard h4 {\n  font-family: 'Cinzel', serif;\n  font-size: 0.82rem;\n  font-weight: 600;\n  color: #fff;\n  margin-bottom: 6px;\n  letter-spacing: 0.05em;\n}\n\n.ca-standard p {\n  font-size: 0.78rem;\n  line-height: 1.6;\n  color: #7a8fa6;\n}\n\n\/* ── MISSION STRIP ── *\/\n.ca-mission {\n  background: linear-gradient(135deg, rgba(201,168,76,0.07), rgba(10,25,42,0.7));\n  border: 1px solid rgba(201,168,76,0.2);\n  border-radius: 8px;\n  padding: 40px;\n  display: flex;\n  align-items: center;\n  gap: 32px;\n  margin-bottom: 32px;\n}\n\n.ca-mission-icon { font-size: 2.8rem; flex-shrink: 0; }\n\n.ca-mission h3 {\n  font-family: 'Cinzel', serif;\n  font-size: 1.2rem;\n  font-weight: 600;\n  color: #fff;\n  margin-bottom: 10px;\n}\n\n.ca-mission h3 span { color: #C9A84C; }\n\n.ca-mission p {\n  font-size: 0.95rem;\n  line-height: 1.8;\n  color: #7a8fa6;\n}\n\n.ca-mission p strong { color: #C9A84C; font-weight: 500; }\n\n\/* ── TAGLINE ── *\/\n.ca-tagline {\n  text-align: center;\n  padding: 32px 24px;\n  font-family: 'Cinzel', serif;\n  font-size: clamp(1rem, 2vw, 1.3rem);\n  font-weight: 600;\n  color: #fff;\n  letter-spacing: 0.1em;\n  border-top: 1px solid rgba(255,255,255,0.06);\n}\n\n.ca-tagline span { color: #C9A84C; }\n\n@media (max-width: 700px) {\n  .ca-source { grid-template-columns: 1fr; gap: 32px; }\n  .ca-hero-content { padding: 32px 24px; }\n  .ca-mission { flex-direction: column; text-align: center; }\n  .ca-philosophy { padding: 32px 24px; }\n}\n<\/style>\n\n<div class=\"ca-wrap\">\n\n  <!-- HERO -->\n  <div class=\"ca-hero\">\n    <div class=\"ca-hero-bg\"><\/div>\n    <div class=\"ca-hero-overlay\"><\/div>\n    <div class=\"ca-hero-wave\"><\/div>\n    <div class=\"ca-hero-content\">\n      <div class=\"ca-badge\">✦ Healthy Kindness · Daily Foundations<\/div>\n      <h1>Vitamins <span>&amp; Minerals<\/span><\/h1>\n      <p class=\"ca-hero-sub\">Trace Minerals · Electrolytes · Essential Nutrients<\/p>\n      <p>This collection focuses on the foundational nutrients the body depends on every day — minerals, vitamins, electrolytes, and nutrient blends that support hydration, energy, recovery, immunity, and overall wellness. These are not extras. They are the building blocks your body runs on.<\/p>\n    <\/div>\n  <\/div>\n\n  <!-- SOURCE STORY -->\n  <div class=\"ca-source\">\n    <div class=\"ca-source-text\">\n      <div class=\"ca-label\">The Foundation<\/div>\n      <h2>What the Body <span>Cannot Skip<\/span><\/h2>\n      <p>Vitamins and minerals are not optional upgrades. They are the raw materials behind virtually every process your body performs — from producing energy at the cellular level to regulating hormones, building bone, firing nerve signals, and supporting immune defense.<\/p>\n      <p>Most people are walking around <strong>chronically deficient<\/strong> in at least one key nutrient — not because they are unhealthy, but because modern food systems have stripped the mineral density from soil, processing has removed nutrients from food, and daily stress depletes reserves faster than diet can replenish them.<\/p>\n      <p>This collection is built in direct connection with the <strong>Fifth Protocol Body curriculum<\/strong> — grounded in the understanding that consistent daily nutrition is the foundation everything else is built on.<\/p>\n    <\/div>\n    <div class=\"ca-source-stats\">\n      <div class=\"ca-stat\">\n        <span class=\"ca-stat-icon\">⚡<\/span>\n        <h4>Cellular Energy<\/h4>\n        <p>Magnesium, B vitamins, and iron are essential cofactors in the body's energy production pathways<\/p>\n      <\/div>\n      <div class=\"ca-stat\">\n        <span class=\"ca-stat-icon\">💧<\/span>\n        <h4>Hydration &amp; Balance<\/h4>\n        <p>Electrolytes regulate fluid balance, nerve function, and muscle contraction at the cellular level<\/p>\n      <\/div>\n      <div class=\"ca-stat\">\n        <span class=\"ca-stat-icon\">🛡️<\/span>\n        <h4>Immune Defense<\/h4>\n        <p>Vitamins C, D, and zinc are among the most researched nutrients for immune system support<\/p>\n      <\/div>\n      <div class=\"ca-stat\">\n        <span class=\"ca-stat-icon\">🦴<\/span>\n        <h4>Structure &amp; Recovery<\/h4>\n        <p>Calcium, magnesium, vitamin K2, and D3 work together for bone density and muscle recovery<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <div class=\"ca-divider\"><\/div>\n\n  <!-- PHILOSOPHY -->\n  <div class=\"ca-philosophy\">\n    <blockquote>\n      \"You cannot build a healthy life<br>\n      on a foundation of <span>nutritional gaps.<\/span>\"\n    <\/blockquote>\n    <cite>Vitamins &amp; Minerals · Healthy Kindness · Fifth Protocol<\/cite>\n  <\/div>\n\n  <div class=\"ca-divider\"><\/div>\n\n  <!-- CATEGORIES -->\n  <div class=\"ca-categories\">\n    <div class=\"ca-label\">What's Inside<\/div>\n    <h2>The <span>Collection<\/span><\/h2>\n    <div class=\"ca-cat-grid\">\n\n      <div class=\"ca-cat-card trace\">\n        <span class=\"ca-cat-icon\">🧲<\/span>\n        <h3>Trace Minerals<\/h3>\n        <p>The minerals your body needs in smaller but critical amounts — each one playing a specific role in enzyme function, hormone production, immune response, and cellular health. Small amounts, significant impact.<\/p>\n        <ul class=\"ca-cat-items\">\n          <li>Zinc — immune function &amp; wound healing<\/li>\n          <li>Magnesium — energy, sleep &amp; muscle function<\/li>\n          <li>Iron — oxygen transport &amp; energy<\/li>\n          <li>Selenium — antioxidant &amp; thyroid support<\/li>\n          <li>Iodine, Chromium, Copper &amp; more<\/li>\n        <\/ul>\n      <\/div>\n\n      <div class=\"ca-cat-card electro\">\n        <span class=\"ca-cat-icon\">💧<\/span>\n        <h3>Electrolytes &amp; Hydration<\/h3>\n        <p>Hydration is not just about water — it is about mineral balance. Electrolytes regulate how water moves in and out of cells, how muscles contract, and how nerve signals fire. Without them, water alone is not enough.<\/p>\n        <ul class=\"ca-cat-items\">\n          <li>Sodium, potassium &amp; chloride balance<\/li>\n          <li>Magnesium for cellular hydration<\/li>\n          <li>Calcium for nerve &amp; muscle function<\/li>\n          <li>Clean electrolyte blends — no artificial dye<\/li>\n          <li>Expanding regularly<\/li>\n        <\/ul>\n      <\/div>\n\n      <div class=\"ca-cat-card daily\">\n        <span class=\"ca-cat-icon\">☀️<\/span>\n        <h3>Daily Nutrient Blends<\/h3>\n        <p>Comprehensive daily formulas that address the most common nutritional gaps in one consistent habit — vitamins, minerals, and supporting nutrients combined for broad daily coverage and long-term wellness.<\/p>\n        <ul class=\"ca-cat-items\">\n          <li>Vitamin D3 + K2 for bone &amp; immune health<\/li>\n          <li>Vitamin C &amp; zinc immune blends<\/li>\n          <li>B-complex for energy &amp; nervous system<\/li>\n          <li>Multivitamin &amp; mineral formulas<\/li>\n          <li>New blends added regularly<\/li>\n        <\/ul>\n      <\/div>\n\n    <\/div>\n  <\/div>\n\n  <div class=\"ca-divider\"><\/div>\n\n  <!-- STANDARDS -->\n  <div class=\"ca-label\" style=\"font-family:'Cinzel',serif;font-size:0.72rem;letter-spacing:0.3em;color:#C9A84C;text-transform:uppercase;margin-bottom:12px;display:flex;align-items:center;gap:10px;\">\n    <span style=\"width:24px;height:1px;background:#C9A84C;display:inline-block;\"><\/span>\n    Our Standards\n  <\/div>\n  <h2 style=\"font-family:'Cinzel',serif;font-size:clamp(1.4rem,3vw,2.2rem);font-weight:600;color:#fff;margin-bottom:28px;\">\n    What We Will <span style=\"color:#C9A84C;\">Never Compromise<\/span>\n  <\/h2>\n\n  <div class=\"ca-standards\">\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">🧬<\/span>\n      <h4>Bioavailable Forms<\/h4>\n      <p>We use forms the body can actually absorb — magnesium glycinate over oxide, methylfolate over folic acid, D3 over D2.<\/p>\n    <\/div>\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">🚫<\/span>\n      <h4>No Unnecessary Fillers<\/h4>\n      <p>No titanium dioxide, artificial colors, or cheap binders. Every capsule and tablet contains what it should and nothing else.<\/p>\n    <\/div>\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">🌍<\/span>\n      <h4>Clean Sourcing<\/h4>\n      <p>Minerals and vitamins sourced from suppliers who meet our standards for purity, testing, and responsible production.<\/p>\n    <\/div>\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">📅<\/span>\n      <h4>Daily Consistency<\/h4>\n      <p>These products are built for daily use — not occasional megadosing. Consistent daily nutrition is the goal, not hype.<\/p>\n    <\/div>\n    <div class=\"ca-standard\">\n      <span class=\"ca-standard-icon\">📖<\/span>\n      <h4>Education First<\/h4>\n      <p>Every product connects to the Fifth Protocol Body curriculum — so you understand what each nutrient does and why it matters daily.<\/p>\n    <\/div>\n  <\/div>\n\n  <div class=\"ca-divider\"><\/div>\n\n  <!-- MISSION -->\n  <div class=\"ca-mission\">\n    <div class=\"ca-mission-icon\">🤝<\/div>\n    <div>\n      <h3>Every Purchase <span>Funds the Mission<\/span><\/h3>\n      <p>The Vitamins &amp; Minerals collection is powered by <strong>Healthy Kindness<\/strong> — and every product you buy supports the <strong>Fifth Protocol mission<\/strong> of educating communities with truth, empowering individuals with real tools for their health, and giving nonprofits a better way to fundraise than selling junk food.<\/p>\n    <\/div>\n  <\/div>\n\n  <!-- TAGLINE -->\n  <div class=\"ca-tagline\">\n    <span>Be True.<\/span> Live Well.\n  <\/div>\n\n<\/div>","color_scheme":"","padding_top":40,"padding_bottom":52}},"banner":{"type":"main-collection-banner","disabled":true,"settings":{"show_collection_description":true,"show_collection_image":false,"color_scheme":"scheme-1"}},"product-grid":{"type":"main-collection-product-grid","settings":{"products_per_page":24,"columns_desktop":4,"columns_mobile":"2","color_scheme":"scheme-1","image_ratio":"portrait","image_shape":"default","show_secondary_image":true,"show_vendor":false,"show_rating":false,"quick_add":"standard","enable_filtering":true,"filter_type":"horizontal","enable_sorting":true,"padding_top":0,"padding_bottom":60}}},"order":["custom_liquid_kLt7xm","banner","product-grid"]}