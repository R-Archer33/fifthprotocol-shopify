{%- liquid
  assign protocol = page.metafields.custom.protocol.value

  assign protocol_name = protocol.protocol_name.value | default: 'Body'
  assign protocol_key = protocol_name | downcase | strip

  assign protocol_order = 'body,mind,soul,earth,universe' | split: ','
  assign protocol_labels = 'Body,Mind,Soul,Earth,Universe' | split: ','
  assign protocol_icons = '&#127807;,&#127744;,&#10024;,&#127757;,&#127756;' | split: ','
  assign protocol_number = '01'
  assign protocol_icon = protocol_icons[0]
  assign next_handle = ''
  assign next_label = ''
  for handle in protocol_order
    if handle == protocol_key
      assign protocol_number = forloop.index | prepend: '0'
      assign protocol_icon = protocol_icons[forloop.index0]
      unless forloop.last
        assign next_handle = protocol_order[forloop.index]
        assign next_label = protocol_labels[forloop.index]
      endunless
    endif
  endfor

  assign hero_tagline = protocol.hero_tagline.value | default: 'Awareness. Discipline. Alignment.'
  assign hero_description = protocol.hero_description.value | default: 'The Body Protocol teaches the physical habits that support every other layer of growth: hydration, food, sleep, movement, recovery, energy, and daily discipline.'

  assign shield_image = protocol.shield_image.value
  assign shield_fallback = 'https://cdn.shopify.com/s/files/1/0690/4522/3590/files/Gemini_Generated_Image_nk96r5nk96r5nk96.jpg'

  assign phase_1_text = protocol.phase_1.value | default: 'Before changing habits, you learn to notice what your body is already telling you: energy, hunger, sleep, stress, digestion, tension, and recovery. Awareness turns the body from something you fight into something you can understand.'
  if protocol.phase_1.type == 'rich_text_field'
    assign phase_1_text = protocol.phase_1 | metafield_text
  endif
  assign phase_2_text = protocol.phase_2.value | default: 'Health is not built by one perfect choice. It is built by repeated choices the body can rely on. This phase focuses on simple routines: hydration, movement, food choices, sleep, and recovery.'
  if protocol.phase_2.type == 'rich_text_field'
    assign phase_2_text = protocol.phase_2 | metafield_text
  endif
  assign phase_3_text = protocol.phase_3.value | default: 'The body does not work in isolated parts. What you eat, how you move, how you sleep, and how you manage stress all affect each other. This phase helps learners see health as a connected system.'
  if protocol.phase_3.type == 'rich_text_field'
    assign phase_3_text = protocol.phase_3 | metafield_text
  endif
  assign phase_4_text = protocol.phase_4.value | default: 'Mastery is not extreme dieting, punishment, or obsession. It is learning balance. This phase teaches how to make healthier choices without swinging between neglect and overcorrection.'
  if protocol.phase_4.type == 'rich_text_field'
    assign phase_4_text = protocol.phase_4 | metafield_text
  endif
  assign phase_5_text = protocol.phase_5.value | default: 'The body is not just for appearance or performance. A healthier body can give you more capacity to serve, work, protect, create, and show up for others. Physical discipline becomes part of a larger purpose.'
  if protocol.phase_5.type == 'rich_text_field'
    assign phase_5_text = protocol.phase_5 | metafield_text
  endif

  assign phase_1_title = protocol.phase_1_title.value | default: 'Listening to the Body Before Fixing the Body'
  assign phase_2_title = protocol.phase_2_title.value | default: 'Health Is Built by Repetition'
  assign phase_3_title = protocol.phase_3_title.value | default: 'Connecting Food, Movement, and Mood'
  assign phase_4_title = protocol.phase_4_title.value | default: 'Moderation, Strength, and Self-Control'
  assign phase_5_title = protocol.phase_5_title.value | default: 'A Healthy Body Becomes a Useful Instrument'

  assign tools_collection = protocol.target_collection.value | default: collections['body-protocol-tools']
  assign lms_link = protocol.lms_link.value | default: '#'

  assign primary_hex = protocol.primary_color_hex.value | append: '' | strip
-%}

{% style %}
  @font-face {
    font-family: 'Cinzel';
    src: url('https://cdn.shopify.com/s/files/1/0690/4522/3590/files/Cinzel-VariableFont_wght.ttf?v=1792451898') format('truetype');
    font-weight: 400 900;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Raleway';
    src: url('https://cdn.shopify.com/s/files/1/0690/4522/3590/files/Raleway-VariableFont_wght.ttf?v=1792451945') format('truetype');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }
{% endstyle %}

<style>

.fp-body-wrap {
  --black: #080e14;
  --navy: #0B1F3A;
  --gold: #C9A84C;
  --gold-light: #f0d080;
  --gold-glow: rgba(201,168,76,0.15);
  --gold-border: rgba(201,168,76,0.3);
  --text: #e8edf2;
  --text-muted: #9aacbe;
  --card-bg: rgba(10,25,42,0.88);

  --protocol-color: #4caf78;
  --protocol-dark: #2e7d4f;
  --protocol-darker: #1a5c35;
  --protocol-glow: rgba(76,175,120,0.35);
  --protocol-border: rgba(76,175,120,0.3);
  --protocol-bg: rgba(76,175,120,0.15);

  --space-xs: 12px;
  --space-sm: 24px;
  --space-md: 48px;
  --space-lg: 80px;

  --text-xs: 0.78rem;
  --text-sm: 0.95rem;
  --text-base: 1.1rem;
  --text-md: 1.2rem;
  --text-lg: clamp(1.6rem, 3.5vw, 2.4rem);
  --text-xl: clamp(2rem, 5vw, 3rem);
  --text-hero: clamp(3rem, 8vw, 6.5rem);
}

.fp-body-wrap * { margin: 0; padding: 0; box-sizing: border-box; }

body,
#MainContent,
.main-content {
  background: #080e14 !important;
  color: #e8edf2 !important;
}



.fp-body-wrap {
  background: var(--black);
  color: var(--text);
  font-family: 'Raleway', sans-serif;
  font-weight: 400;
  font-size: var(--text-base);
  line-height: 1.8;
  overflow-x: hidden;
  min-height: 100vh;
  width: 100%;
  position: relative;
}

.fp-body-wrap a { text-decoration: none; color: inherit; }
.fp-body-wrap img { display: block; }

.fp-body-wrap .page-wrap { position: relative; z-index: 1; }
.fp-body-wrap section { padding: var(--space-lg) var(--space-sm); max-width: 1100px; margin: 0 auto; }

.fp-body-wrap .divider {
  width: 100%;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  opacity: 0.3;
}

.fp-body-wrap .hero-starfield {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 20% 20%, rgba(46,125,79,0.07) 0%, transparent 60%),
    radial-gradient(ellipse at 80% 80%, rgba(11,31,58,0.55) 0%, transparent 70%);
}

.fp-body-wrap .hero-starfield::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(1.5px 1.5px at 5% 8%, rgba(255,255,255,0.75) 0%, transparent 100%),
    radial-gradient(1px 1px at 15% 25%, rgba(255,255,255,0.45) 0%, transparent 100%),
    radial-gradient(1px 1px at 22% 55%, rgba(255,255,255,0.35) 0%, transparent 100%),
    radial-gradient(1.5px 1.5px at 30% 12%, rgba(255,255,255,0.55) 0%, transparent 100%),
    radial-gradient(1px 1px at 42% 70%, rgba(255,255,255,0.45) 0%, transparent 100%),
    radial-gradient(1.5px 1.5px at 58% 88%, rgba(255,255,255,0.55) 0%, transparent 100%),
    radial-gradient(1.5px 1.5px at 72% 44%, rgba(255,255,255,0.65) 0%, transparent 100%),
    radial-gradient(1px 1px at 86% 30%, rgba(255,255,255,0.45) 0%, transparent 100%),
    radial-gradient(1.5px 1.5px at 93% 76%, rgba(255,255,255,0.55) 0%, transparent 100%);
  animation: twinkle 9s ease infinite alternate;
}

@keyframes twinkle { 0% { opacity: 0.45; } 100% { opacity: 1; } }

.fp-body-wrap .section-label {
  font-family: 'Cinzel', serif;
  font-size: var(--text-xs);
  letter-spacing: 0.32em;
  color: var(--protocol-color);
  text-transform: uppercase;
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.fp-body-wrap .section-label::before {
  content: '';
  width: 28px;
  height: 1px;
  background: var(--protocol-color);
  flex-shrink: 0;
}

.fp-body-wrap .section-label.centered { justify-content: center; }
.fp-body-wrap .section-label.centered::before { display: none; }
.fp-body-wrap .section-label.gold-label { color: var(--gold); }
.fp-body-wrap .section-label.gold-label::before { background: var(--gold); }

.fp-body-wrap .section-title {
  font-family: 'Cinzel', serif;
  font-size: var(--text-lg);
  font-weight: 600;
  color: #fff;
  line-height: 1.2;
  margin-bottom: 14px;
}

.fp-body-wrap .section-title span { color: var(--protocol-color); }
.fp-body-wrap .section-title span.gold { color: var(--gold); }

.fp-body-wrap .section-desc {
  font-size: var(--text-base);
  line-height: 1.9;
  color: var(--text-muted);
  max-width: 720px;
  margin-bottom: 44px;
}

.fp-body-wrap .btn {
  font-family: 'Cinzel', serif;
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  border-radius: 3px;
  padding: 15px 38px;
  display: inline-block;
  cursor: pointer;
  transition: transform 0.28s ease, box-shadow 0.28s ease, background 0.28s ease;
  border: none;
  line-height: 1;
  text-decoration: none;
}

.fp-body-wrap .btn:focus { outline: 2px solid var(--gold); outline-offset: 3px; }

.fp-body-wrap .btn,
.fp-body-wrap .btn-primary,
.fp-body-wrap .btn-secondary,
.fp-body-wrap .btn-outline {
  text-decoration: none !important;
}

.fp-body-wrap .btn-primary {
  background: linear-gradient(135deg, var(--protocol-dark), var(--protocol-darker));
  color: #ffffff !important;
  border: 1px solid var(--protocol-border);
  box-shadow: 0 4px 20px rgba(46,125,79,0.28);
}

.fp-body-wrap .btn-primary:hover {
  color: #ffffff !important;
  transform: translateY(-2px);
  box-shadow: 0 8px 32px rgba(46,125,79,0.45);
}

.fp-body-wrap .btn-secondary {
  background: rgba(201,168,76,0.12);
  color: var(--gold-light) !important;
  border: 2px solid var(--gold);
}

.fp-body-wrap .btn-secondary:hover {
  background: rgba(201,168,76,0.22);
  color: #ffffff !important;
  border-color: var(--gold-light);
  transform: translateY(-2px);
}

.fp-body-wrap .btn-outline {
  background: transparent;
  color: var(--gold-light) !important;
  border: 2px solid var(--gold);
}

.fp-body-wrap .btn-outline:hover {
  background: rgba(201,168,76,0.14);
  color: #ffffff !important;
  transform: translateY(-2px);
}

.fp-body-wrap .hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 100px var(--space-sm) 90px;
  position: relative;
}

.fp-body-wrap .hero-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fp-body-wrap .protocol-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  border: 1px solid var(--protocol-border);
  background: var(--protocol-bg);
  border-radius: 40px;
  padding: 10px 26px;
  font-family: 'Cinzel', serif;
  font-size: var(--text-xs);
  letter-spacing: 0.22em;
  color: var(--protocol-color);
  text-transform: uppercase;
  margin-bottom: 28px;
  animation: fadeUp 0.8s ease both;
}

.fp-body-wrap .protocol-badge .dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--protocol-color);
  box-shadow: 0 0 8px var(--protocol-color);
  animation: pulse 2s ease infinite;
}

@keyframes pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.78); } }

.fp-body-wrap .hero-eyebrow {
  font-family: 'Cinzel', serif;
  font-size: clamp(0.7rem, 1.4vw, 0.85rem);
  letter-spacing: 0.38em;
  color: var(--gold);
  text-transform: uppercase;
  margin-bottom: 18px;
  animation: fadeUp 0.9s ease both 0.1s;
}

.fp-body-wrap .hero-shield {
  width: 260px;
  height: 260px;
  object-fit: contain;
  margin-bottom: 28px;
  filter: drop-shadow(0 0 38px var(--protocol-glow));
  animation: floatImg 5s ease-in-out infinite, fadeUp 1s ease both 0.15s;
}

@keyframes floatImg { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }

.fp-body-wrap .hero h1 {
  font-family: 'Cinzel', serif;
  font-size: var(--text-hero);
  font-weight: 700;
  line-height: 1.0;
  color: #fff;
  margin-bottom: 14px;
  letter-spacing: 0.05em;
  animation: fadeUp 1s ease both 0.2s;
}

.fp-body-wrap .hero h1 span {
  color: var(--protocol-color);
  text-shadow: 0 0 56px var(--protocol-glow);
}

.fp-body-wrap .hero-sub {
  font-family: 'Cinzel', serif;
  font-size: clamp(0.88rem, 1.8vw, 1.15rem);
  letter-spacing: 0.24em;
  color: var(--gold);
  text-transform: uppercase;
  margin-bottom: 22px;
  animation: fadeUp 1s ease both 0.3s;
}

.fp-body-wrap .hero-desc {
  max-width: 700px;
  font-size: var(--text-md);
  line-height: 1.9;
  color: var(--text-muted);
  margin-bottom: 44px;
  animation: fadeUp 1s ease both 0.4s;
}

.fp-body-wrap .hero-cta {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  justify-content: center;
  animation: fadeUp 1s ease both 0.5s;
}

.fp-body-wrap .scroll-hint {
  position: absolute;
  bottom: 32px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  color: var(--text-muted);
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.fp-body-wrap .scroll-hint::after {
  content: '';
  width: 1px;
  height: 38px;
  background: linear-gradient(to bottom, var(--protocol-color), transparent);
  animation: scrollDrop 2.2s ease infinite;
}

@keyframes scrollDrop {
  0% { opacity: 0; transform: scaleY(0); transform-origin: top; }
  50% { opacity: 1; transform: scaleY(1); }
  100% { opacity: 0; transform: scaleY(1); transform-origin: bottom; }
}

.fp-body-wrap .intro-wrap { max-width: 850px; margin: 0 auto; text-align: center; }

.fp-body-wrap .intro-wrap p {
  font-size: var(--text-md);
  line-height: 1.95;
  color: var(--text-muted);
  margin-bottom: 18px;
}

.fp-body-wrap .intro-wrap p:last-child { margin-bottom: 0; }
.fp-body-wrap .intro-wrap p strong { color: var(--protocol-color); font-weight: 600; }

.fp-body-wrap .curriculum-intro { margin-bottom: 44px; }

.fp-body-wrap .phase-wrap { margin-bottom: 42px; }
.fp-body-wrap .phase-wrap:last-child { margin-bottom: 0; }

.fp-body-wrap .phase-header {
  display: grid;
  grid-template-columns: 64px 1fr;
  align-items: start;
  gap: 20px;
  margin-bottom: 24px;
  padding: 26px;
  background: linear-gradient(135deg, rgba(46,125,79,0.10), rgba(10,25,42,0.75));
  border: 1px solid var(--protocol-border);
  border-radius: 6px;
  position: relative;
  overflow: hidden;
}

.fp-body-wrap .phase-header::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background: linear-gradient(to bottom, var(--protocol-color), transparent);
}

.fp-body-wrap .phase-num-badge {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--protocol-dark), var(--protocol-darker));
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Cinzel', serif;
  font-size: 1.25rem;
  font-weight: 700;
  color: #fff;
  box-shadow: 0 0 20px rgba(46,125,79,0.28);
  flex-shrink: 0;
}

.fp-body-wrap .phase-eyebrow {
  font-family: 'Cinzel', serif;
  font-size: var(--text-xs);
  letter-spacing: 0.25em;
  color: var(--protocol-color);
  text-transform: uppercase;
  margin-bottom: 6px;
}

.fp-body-wrap .phase-name {
  font-family: 'Cinzel', serif;
  font-size: clamp(1.2rem, 2.5vw, 1.7rem);
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
  margin-bottom: 8px;
}

.fp-body-wrap .phase-rationale {
  font-size: var(--text-base);
  line-height: 1.8;
  color: var(--text-muted);
  max-width: 760px;
}

.fp-body-wrap .articles-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 24px;
}

.fp-body-wrap .article-card {
  background: var(--card-bg);
  border: 1px solid rgba(201,168,76,0.18);
  border-radius: 5px;
  overflow: hidden;
  transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
  text-decoration: none;
  display: block;
}

.fp-body-wrap .article-card:hover {
  border-color: rgba(201,168,76,0.48);
  transform: translateY(-4px);
  box-shadow: 0 12px 36px rgba(0,0,0,0.28);
}

.fp-body-wrap .article-img {
  height: 190px;
  background: linear-gradient(135deg, rgba(46,125,79,0.28), rgba(11,31,58,0.8));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 4rem;
  position: relative;
}

.fp-body-wrap .article-img::after {
  content: 'OPEN';
  position: absolute;
  bottom: 13px;
  right: 13px;
  font-family: 'Cinzel', serif;
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  color: var(--protocol-color);
  background: rgba(0,0,0,0.58);
  padding: 5px 11px;
  border: 1px solid rgba(76,175,120,0.38);
  border-radius: 2px;
}

.fp-body-wrap .article-inner { padding: 26px; }

.fp-body-wrap .article-tag {
  font-family: 'Cinzel', serif;
  font-size: 0.64rem;
  letter-spacing: 0.2em;
  color: var(--protocol-color);
  text-transform: uppercase;
  margin-bottom: 11px;
  display: block;
}

.fp-body-wrap .article-card h3 {
  font-family: 'Cinzel', serif;
  font-size: 1.02rem;
  font-weight: 600;
  color: #fff;
  margin-bottom: 11px;
  line-height: 1.4;
}

.fp-body-wrap .article-card p {
  font-size: var(--text-sm);
  line-height: 1.78;
  color: var(--text-muted);
  margin-bottom: 18px;
}

.fp-body-wrap .article-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.8rem;
  color: var(--text-muted);
}

.fp-body-wrap .read-link {
  font-family: 'Cinzel', serif;
  font-size: 0.64rem;
  letter-spacing: 0.15em;
  color: var(--gold);
  text-transform: uppercase;
}

.fp-body-wrap .topics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 18px;
  margin-top: 24px;
}

.fp-body-wrap .topic-card {
  background: var(--card-bg);
  border: 1px solid var(--protocol-border);
  border-radius: 5px;
  padding: 24px;
  position: relative;
  overflow: hidden;
  transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
}

.fp-body-wrap .topic-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--protocol-color), transparent);
  opacity: 0;
  transition: opacity 0.28s ease;
}

.fp-body-wrap .topic-card:hover {
  border-color: var(--protocol-color);
  transform: translateY(-4px);
  box-shadow: 0 10px 30px rgba(76,175,120,0.10);
}

.fp-body-wrap .topic-card:hover::before { opacity: 1; }

.fp-body-wrap .topic-icon {
  width: 48px;
  height: 48px;
  background: var(--protocol-bg);
  border: 1px solid var(--protocol-border);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
  margin-bottom: 14px;
}

.fp-body-wrap .topic-card h3 {
  font-family: 'Cinzel', serif;
  font-size: 1.02rem;
  font-weight: 600;
  color: #fff;
  margin-bottom: 10px;
  letter-spacing: 0.04em;
  line-height: 1.3;
}

.fp-body-wrap .topic-desc {
  font-size: var(--text-sm);
  line-height: 1.75;
  color: var(--text-muted);
}

.fp-body-wrap .learning-note {
  background: linear-gradient(135deg, rgba(201,168,76,0.08), rgba(10,25,42,0.82));
  border: 1px solid rgba(201,168,76,0.22);
  border-radius: 5px;
  padding: 30px;
  margin-top: 34px;
}

.fp-body-wrap .learning-note p {
  font-size: var(--text-base);
  line-height: 1.9;
  color: var(--text-muted);
}

.fp-body-wrap .learning-note strong {
  color: var(--gold);
  font-weight: 600;
}

.fp-body-wrap .progression {
  text-align: center;
  padding: var(--space-lg) var(--space-sm);
  background: linear-gradient(to bottom, transparent, rgba(11,31,58,0.45), transparent);
}

.fp-body-wrap .progression h2 {
  font-family: 'Cinzel', serif;
  font-size: var(--text-lg);
  font-weight: 600;
  color: #fff;
  margin: 14px 0 16px;
}

.fp-body-wrap .progression h2 span { color: var(--protocol-color); }

.fp-body-wrap .progression-body {
  font-size: var(--text-base);
  line-height: 1.9;
  color: var(--text-muted);
  max-width: 720px;
  margin: 0 auto;
}

.fp-body-wrap .progression-track {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 44px;
  gap: 0;
}

.fp-body-wrap .prog-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 11px;
  padding: 0 18px;
}

.fp-body-wrap .prog-circle {
  width: 76px;
  height: 76px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.75rem;
  border: 1px solid;
  transition: all 0.28s ease;
}

.fp-body-wrap .prog-item.active .prog-circle {
  background: rgba(46,125,79,0.18);
  border-color: var(--protocol-color);
  box-shadow: 0 0 28px rgba(76,175,120,0.28);
}

.fp-body-wrap .prog-item:not(.active) .prog-circle {
  background: rgba(255,255,255,0.03);
  border-color: rgba(255,255,255,0.1);
  opacity: 0.5;
}

.fp-body-wrap .prog-label {
  font-family: 'Cinzel', serif;
  font-size: 0.68rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--text-muted);
}

.fp-body-wrap .prog-item.active .prog-label { color: var(--protocol-color); }
.fp-body-wrap .prog-arrow { color: rgba(255,255,255,0.14); font-size: 1.3rem; padding-bottom: 22px; }
.fp-body-wrap .prog-next { margin-top: 48px; display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

.fp-body-wrap .footer-strip {
  border-top: 1px solid rgba(255,255,255,0.05);
  padding: var(--space-md) var(--space-sm);
  text-align: center;
  max-width: 1100px;
  margin: 0 auto;
}

.fp-body-wrap .footer-strip p {
  font-family: 'Cinzel', serif;
  font-size: var(--text-sm);
  letter-spacing: 0.2em;
  color: var(--text-muted);
  text-transform: uppercase;
}

.fp-body-wrap .footer-strip span { color: var(--gold); }

.fp-body-wrap .footer-links {
  display: flex;
  gap: 22px;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 14px;
}

.fp-body-wrap .footer-links a {
  font-family: 'Cinzel', serif;
  font-size: 0.78rem;
  letter-spacing: 0.14em;
  color: var(--text-muted);
  text-transform: uppercase;
  text-decoration: none;
  transition: color 0.25s;
}

.fp-body-wrap .footer-links a:hover { color: var(--gold); }

@keyframes fadeUp { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }

@media (prefers-reduced-motion: reduce) {

  .fp-body-wrap .hero-starfield::before,
.fp-body-wrap .hero-shield,
.fp-body-wrap .protocol-badge .dot {
    animation: none;
  }
  .fp-body-wrap * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }

}

@media (max-width: 700px) {

  .fp-body-wrap section { padding: var(--space-md) var(--space-sm); }
  .fp-body-wrap .hero { padding: 80px var(--space-sm) 80px; }
  .fp-body-wrap .topics-grid,
.fp-body-wrap .articles-grid { grid-template-columns: 1fr; }
  .fp-body-wrap .phase-header { grid-template-columns: 1fr; text-align: center; padding: 22px 20px; }
  .fp-body-wrap .phase-header::before { display: none; }
  .fp-body-wrap .phase-num-badge { margin: 0 auto; }
  .fp-body-wrap .prog-arrow { display: none; }
  .fp-body-wrap .prog-item { padding: 0 10px; }
  .fp-body-wrap .progression-track { gap: 8px; }

}

@media (max-width: 420px) {

  .fp-body-wrap .hero h1 { font-size: 2.8rem; }
  .fp-body-wrap .progression-track { flex-direction: column; gap: 16px; }
  .fp-body-wrap .prog-item { flex-direction: row; gap: 14px; }

}
</style>

