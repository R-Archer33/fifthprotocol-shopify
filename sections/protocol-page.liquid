}
</style>

{%- if primary_hex != blank -%}
  {%- liquid
    assign protocol_dark = primary_hex | color_darken: 15
    assign protocol_darker = primary_hex | color_darken: 28
    assign protocol_glow = primary_hex | color_modify: 'alpha', 0.35
    assign protocol_border = primary_hex | color_modify: 'alpha', 0.3
    assign protocol_bg = primary_hex | color_modify: 'alpha', 0.15
    assign dark_10 = protocol_dark | color_modify: 'alpha', 0.1
    assign dark_07 = protocol_dark | color_modify: 'alpha', 0.07
    assign dark_18 = protocol_dark | color_modify: 'alpha', 0.18
    assign dark_28 = protocol_dark | color_modify: 'alpha', 0.28
    assign dark_45 = protocol_dark | color_modify: 'alpha', 0.45
    assign primary_10 = primary_hex | color_modify: 'alpha', 0.1
    assign primary_28 = primary_hex | color_modify: 'alpha', 0.28
    assign primary_38 = primary_hex | color_modify: 'alpha', 0.38
  -%}
  {% style %}
    .fp-body-wrap.fp-protocol-page {
      --protocol-color: {{ primary_hex }};
      --protocol-dark: {{ protocol_dark }};
      --protocol-darker: {{ protocol_darker }};
      --protocol-glow: {{ protocol_glow }};
      --protocol-border: {{ protocol_border }};
      --protocol-bg: {{ protocol_bg }};
    }

    .fp-body-wrap.fp-protocol-page .hero-starfield {
      background:
        radial-gradient(ellipse at 20% 20%, {{ dark_07 }} 0%, transparent 60%),
        radial-gradient(ellipse at 80% 80%, rgba(11,31,58,0.55) 0%, transparent 70%);
    }

    .fp-body-wrap.fp-protocol-page .btn-primary { box-shadow: 0 4px 20px {{ dark_28 }}; }
    .fp-body-wrap.fp-protocol-page .btn-primary:hover { box-shadow: 0 8px 32px {{ dark_45 }}; }
    .fp-body-wrap.fp-protocol-page .phase-header { background: linear-gradient(135deg, {{ dark_10 }}, rgba(10,25,42,0.75)); }
    .fp-body-wrap.fp-protocol-page .phase-num-badge { box-shadow: 0 0 20px {{ dark_28 }}; }
    .fp-body-wrap.fp-protocol-page .article-img { background: linear-gradient(135deg, {{ dark_28 }}, rgba(11,31,58,0.8)); }
    .fp-body-wrap.fp-protocol-page .article-img::after { border-color: {{ primary_38 }}; }
    .fp-body-wrap.fp-protocol-page .topic-card:hover { box-shadow: 0 10px 30px {{ primary_10 }}; }
    .fp-body-wrap.fp-protocol-page .prog-item.active .prog-circle {
      background: {{ dark_18 }};
      box-shadow: 0 0 28px {{ primary_28 }};
    }
  {% endstyle %}
{%- endif -%}

